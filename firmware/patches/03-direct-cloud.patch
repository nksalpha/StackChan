+void DirectProtocol::EmitJson(const char* type, const char* key1, const char* val1,
+                              const char* key2, const char* val2) {
+    if (!on_incoming_json_) return;
+    cJSON* root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "type", type);
+    if (key1) cJSON_AddStringToObject(root, key1, val1);
+    if (key2) cJSON_AddStringToObject(root, key2, val2);
+    on_incoming_json_(root);
+    cJSON_Delete(root);
+}
+
+void DirectProtocol::OnAsrMessage(const char* data, size_t len) {
+    last_incoming_time_ = std::chrono::steady_clock::now();
+    cJSON* root = cJSON_ParseWithLength(data, len);
+    if (!root) return;
+    auto type = cJSON_GetObjectItem(root, "type");
+    if (cJSON_IsString(type)) {
+        if (strcmp(type->valuestring, "Results") == 0) {
+            bool is_final = cJSON_IsTrue(cJSON_GetObjectItem(root, "is_final"));
+            bool speech_final = cJSON_IsTrue(cJSON_GetObjectItem(root, "speech_final"));
+            bool from_finalize = cJSON_IsTrue(cJSON_GetObjectItem(root, "from_finalize"));
+            const char* transcript = nullptr;
+            auto channel = cJSON_GetObjectItem(root, "channel");
+            auto alts = channel ? cJSON_GetObjectItem(channel, "alternatives") : nullptr;
+            auto alt0 = alts ? cJSON_GetArrayItem(alts, 0) : nullptr;
+            auto t = alt0 ? cJSON_GetObjectItem(alt0, "transcript") : nullptr;
+            if (cJSON_IsString(t)) transcript = t->valuestring;
+
+            if (transcript && transcript[0] && listening_) {
+                ESP_LOGI(TAG, "ASR +%lld ms %s%s%s: %s",
+                         (esp_timer_get_time() - listen_start_us_) / 1000,
+                         is_final ? "final" : "interim", speech_final ? " speech_final" : "",
+                         from_finalize ? " from_finalize" : "", transcript);
+                std::lock_guard<std::mutex> lock(asr_mutex_);
+                last_transcript_us_ = esp_timer_get_time();
+                if (is_final) {
+                    if (!utterance_.empty()) utterance_ += " ";
+                    utterance_ += transcript;
+                    interim_.clear();
+                } else {
+                    interim_ = transcript;
+                }
+            }
+            if (speech_final || from_finalize) FinishUtterance();
+        } else if (strcmp(type->valuestring, "UtteranceEnd") == 0) {
+            ESP_LOGI(TAG, "ASR +%lld ms UtteranceEnd", (esp_timer_get_time() - listen_start_us_) / 1000);
+            FinishUtterance();
+        } else if (strcmp(type->valuestring, "Error") == 0 ||
+                   strcmp(type->valuestring, "error") == 0) {
+            char* s = cJSON_PrintUnformatted(root);
+            ESP_LOGE(TAG, "Deepgram error: %s", s ? s : "");
+            if (s) cJSON_free(s);
+        }
+    }
+    cJSON_Delete(root);
+}
+
+void DirectProtocol::CheckVadFinalize() {
+    if (!listening_) return;
+    int64_t now = esp_timer_get_time();
+    {
+        // 대답 뒤(또는 깨운 뒤) 10초 동안 인식된 말이 없으면 대기 상태로: 계속 올려 보내면 Deepgram 요금이 나간다
+        std::unique_lock<std::mutex> lock(asr_mutex_);
+        bool idle = utterance_.empty() && interim_.empty() &&
+                    now - std::max(listen_start_us_, last_transcript_us_) > kIdleListenUs;
+        lock.unlock();
+        if (idle) {
+            ESP_LOGI(TAG, "No speech for %lld s, back to idle", kIdleListenUs / 1000000);
+            listening_ = false;
+            RequestMemoryUpdate();
+            if (channel_open_.exchange(false) && on_audio_channel_closed_) on_audio_channel_closed_();
+            return;
+        }
+    }
+    bool voice = Application::GetInstance().GetAudioService().IsVoiceDetected();
+    bool have_text;
+    {
+        std::lock_guard<std::mutex> lock(asr_mutex_);
+        if (voice) {
+            last_voice_us_ = now;
+            had_voice_ = true;
+            finalize_sent_ = false;  // 다시 말하기 시작하면 다음 무음에서 또 마무리할 수 있게
+            return;
+        }
+        have_text = !utterance_.empty() || !interim_.empty();
+        // 글자가 아직 안 왔어도 Deepgram이 받은 음성으로 마무리하게 한다
+        if (!had_voice_ || finalize_sent_) return;
+        if (now - last_voice_us_ < 1000 * 1000) return;
+        finalize_sent_ = true;
+    }
+    ESP_LOGI(TAG, "ASR +%lld ms device VAD silence, Finalize%s", (now - listen_start_us_) / 1000,
+             have_text ? "" : " (no text yet)");
+    std::unique_lock<std::mutex> lock(ws_mutex_, std::try_to_lock);
+    if (lock.owns_lock() && asr_ws_ && asr_ws_->IsConnected()) {
+        asr_ws_->Send(std::string("{\"type\":\"Finalize\"}"));
+    }
+}
+
+void DirectProtocol::FinishUtterance() {
+    std::string text;
+    {
+        std::lock_guard<std::mutex> lock(asr_mutex_);
+        if (!listening_ || utterance_.empty()) return;
+        text = Trim(utterance_);
+        utterance_.clear();
+        listening_ = false;
+    }
+    if (text.empty()) {
+        listening_ = true;
+        return;
+    }
+    EmitJson("stt", "text", text.c_str());
+    EmitJson("llm", "emotion", "thinking");  // 대답을 기다리는 동안 생각하는 얼굴
+
+    // 어른용 음성 명령: "설정 모드" → 설정 화면(Xiaozhi-XXXX, 192.168.4.1)으로
+    {
+        std::string compact;
+        for (char ch : text) if (ch != ' ') compact.push_back(ch);
+        if (compact.find("설정모드") != std::string::npos) {
+            ESP_LOGI(TAG, "Voice command: enter config mode");
+            RequestMemoryUpdate();
+            Application::GetInstance().Schedule([]() {
+                static_cast<WifiBoard&>(Board::GetInstance()).EnterWifiConfigMode();
+            });
+            return;
+        }
+    }
+
+    uint32_t turn = turn_.fetch_add(1) + 1;
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        llm_jobs_.emplace_back(turn, text);
+    }
+    cv_.notify_all();
+}
+
+std::string DirectProtocol::BuildLlmBody(const std::string& user_text) {
+    cJSON* root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "model", config_.llm_model.c_str());
+    cJSON_AddBoolToObject(root, "stream", true);
+    cJSON_AddNumberToObject(root, "max_tokens", 300);
+    if (thinking_param_ok_) {
+        // 짧은 잡담에는 추론 단계가 필요 없다. 서버가 이 옵션을 모르면 RunLlm에서 빼고 다시 보낸다.
+        cJSON* thinking = cJSON_AddObjectToObject(root, "thinking");
+        cJSON_AddStringToObject(thinking, "type", "disabled");
+    }
+    cJSON* msgs = cJSON_AddArrayToObject(root, "messages");
+    auto add = [msgs](const char* role, const std::string& content) {
+        cJSON* m = cJSON_CreateObject();
+        cJSON_AddStringToObject(m, "role", role);
+        cJSON_AddStringToObject(m, "content", content.c_str());
+        cJSON_AddItemToArray(msgs, m);
+    };
+    {
+        std::string sys = kSystemPrompt;
+        std::string now = CurrentTimeText();
+        ESP_LOGI(TAG, "LLM time context: %s", now.empty() ? "(clock not set)" : now.c_str());
+        if (!now.empty()) {
+            sys += "\n지금은 한국 시간으로 " + now + "이야. 날짜, 요일, 시간을 물으면 이걸 보고 대답해.";
+        } else {
+            sys += "\n지금 시각은 아직 알 수 없어. 시간을 물으면 시계를 맞추는 중이라고 말해.";
+        }
+        {
+            std::lock_guard<std::mutex> lock(memory_mutex_);
+            if (!memory_.empty()) {
+                sys += "\n\n[이 아이에 대해 기억하고 있는 것]\n" + memory_ +
+                       "\n이걸 자연스럽게 활용해서 맞춤으로 대답해. 기억을 줄줄이 읽어 주지는 마.";
+            }
+        }
+        if (notice_pending_.exchange(false)) {
+            last_notice_us_ = esp_timer_get_time();
+            sys += "\n지금 인터넷이 느려서 말을 잘못 알아들었을 수 있어. 이번 대답은 '인터넷이 조금 느린 것 같아.'로 짧게 시작해.";
+        }
+        add("system", sys);
+    }
+    {
+        std::lock_guard<std::mutex> lock(history_mutex_);
+        for (auto& h : history_) {
+            add("user", h.first);
+            add("assistant", h.second);
+        }
+    }
+    add("user", user_text);
+    char* s = cJSON_PrintUnformatted(root);
+    std::string body = s ? s : "";
+    if (s) cJSON_free(s);
+    cJSON_Delete(root);
+    return body;
+}
+
+void DirectProtocol::LlmLoop() {
+    while (true) {
+        std::pair<uint32_t, std::string> job;
+        {
+            std::unique_lock<std::mutex> lock(mutex_);
+            cv_.wait(lock, [this]() { return stop_ || !llm_jobs_.empty(); });
+            if (stop_) return;
+            job = std::move(llm_jobs_.front());
+            llm_jobs_.pop_front();
+        }
+        if (job.first == 0) {
+            if (job.second == "asr") EnsureAsrConnected();
+            // DeepSeek 연결 예열 (모델 목록 조회, 연결은 keep-alive로 재사용)
+            auto network = Board::GetInstance().GetNetwork();
+            if (!llm_http_) {
+                llm_http_ = network->CreateHttp(2);
+                llm_http_->SetKeepAlive(true);
+            }
+            int64_t t0 = esp_timer_get_time();
+            llm_http_->SetTimeout(10000);
+            llm_http_->SetHeader("Authorization", "Bearer " + config_.deepseek_key);
+            if (llm_http_->Open("GET", "https://api.deepseek.com/models")) {
+                auto st = llm_http_->GetStatusCode();
+                std::string body = llm_http_->ReadAll();
+                ESP_LOGI(TAG, "Warmup DeepSeek status=%d in %lld ms", st ? *st : -1,
+                         (esp_timer_get_time() - t0) / 1000);
+                if (!st || *st != 200) {
+                    ESP_LOGE(TAG, "DeepSeek: %.200s", body.c_str());
+                } else if (job.second == "asr") {
+                    // 처음 한 번만: 이 키로 쓸 수 있는 모델 이름을 남긴다
+                    cJSON* j = cJSON_Parse(body.c_str());
+                    auto data = j ? cJSON_GetObjectItem(j, "data") : nullptr;
+                    std::string ids;
+                    cJSON* m = nullptr;
+                    cJSON_ArrayForEach(m, data) {
+                        auto id = cJSON_GetObjectItem(m, "id");
+                        if (cJSON_IsString(id)) { ids += id->valuestring; ids += " "; }
+                    }
+                    if (j) cJSON_Delete(j);
+                    ESP_LOGI(TAG, "DeepSeek models: %s", ids.c_str());
+                }
+            } else {
+                llm_http_->Close();
+            }
+            continue;
+        }
+        if (IsCurrent(job.first)) RunLlm(job.first, job.second);
+    }
+}
+
+void DirectProtocol::RunLlm(uint32_t turn, const std::string& user_text) {
+    int64_t t0 = esp_timer_get_time();
+    auto network = Board::GetInstance().GetNetwork();
+    if (!llm_http_) {
+        llm_http_ = network->CreateHttp(2);
+        llm_http_->SetKeepAlive(true);
+    }
+    auto& http = llm_http_;
+    http->SetTimeout(15000);
+    auto prepare = [&]() {
+        http->SetTimeout(15000);
+        http->SetHeader("Authorization", "Bearer " + config_.deepseek_key);
+        http->SetHeader("Content-Type", "application/json");
+        http->SetHeader("Accept", "text/event-stream");
+        http->SetContent(BuildLlmBody(user_text));
+    };
+    prepare();
+
+    auto finish_with_error = [&](const char* msg) {
+        ESP_LOGE(TAG, "%s", msg);
+        http->Close();
+        if (IsCurrent(turn)) {
+            std::lock_guard<std::mutex> lock(mutex_);
+            tts_jobs_.push_back({turn, "죄송해요, 지금은 대답하기 어려워요.", true});
+            cv_.notify_all();
+        }
+    };
+
+    if (!http->Open("POST", kDeepseekUrl)) {
+        finish_with_error("DeepSeek open failed");
+        return;
+    }
+    auto status = http->GetStatusCode();
+    if (status && *status == 400 && thinking_param_ok_) {
+        // 추론 끄기 옵션을 받아주지 않는 모델: 옵션을 빼고 한 번 더
+        std::string body = http->ReadAll();
+        ESP_LOGW(TAG, "DeepSeek rejected thinking option, retrying without: %.200s", body.c_str());
+        thinking_param_ok_ = false;
+        prepare();
+        if (!http->Open("POST", kDeepseekUrl)) {
+            finish_with_error("DeepSeek open failed");
+            return;
+        }
+        status = http->GetStatusCode();
+    }
+    if (!status || *status != 200) {
+        std::string body = http->ReadAll();
+        ESP_LOGE(TAG, "DeepSeek status %d: %.200s", status ? *status : -1, body.c_str());
+        finish_with_error("DeepSeek request failed");
+        return;
+    }
+    ESP_LOGI(TAG, "LAT llm_headers=%lld ms", (esp_timer_get_time() - t0) / 1000);
+
+    std::string line_buf, text_buf, full_reply;
+    bool emotion_done = false, first_sentence = true, first_token = true;
+    size_t reasoning_chars = 0;  // 생각(추론) 단계가 있는 모델이면 여기로 먼저 온다
+    char buf[512];
+    bool done = false;
+
+    std::string first_emotion;
+    auto push_sentence = [&](const std::string& raw, bool last) {
+        std::string text = raw;
+        std::string emotion = StripEmotionTags(text);
+        if (emotion.empty() && !first_emotion.empty()) emotion = first_emotion;
+        first_emotion.clear();
+        std::string s = CleanForSpeech(text);
+        if (s.empty() && !last) return;
+        std::lock_guard<std::mutex> lock(mutex_);
+        tts_jobs_.push_back({turn, s, last, emotion});
+        cv_.notify_all();
+    };
+
+    while (!done) {
+        if (!IsCurrent(turn)) {  // 중간에 끊김
+            http->Close();
+            return;
+        }
+        auto r = http->Read(buf, sizeof(buf));
+        if (!r || *r <= 0) break;
+        line_buf.append(buf, *r);
+        size_t pos;
+        while ((pos = line_buf.find('\n')) != std::string::npos) {
+            std::string line = Trim(line_buf.substr(0, pos));
+            line_buf.erase(0, pos + 1);
+            if (line.rfind("data:", 0) != 0) continue;  // ": keep-alive" 등
+            std::string payload = Trim(line.substr(5));
+            if (payload == "[DONE]") {
+                done = true;
+                break;
+            }
+            cJSON* j = cJSON_Parse(payload.c_str());
+            if (!j) continue;
+            auto choices = cJSON_GetObjectItem(j, "choices");
+            auto c0 = choices ? cJSON_GetArrayItem(choices, 0) : nullptr;
+            auto delta = c0 ? cJSON_GetObjectItem(c0, "delta") : nullptr;
+            auto content = delta ? cJSON_GetObjectItem(delta, "content") : nullptr;
+            auto reasoning = delta ? cJSON_GetObjectItem(delta, "reasoning_content") : nullptr;
+            if (cJSON_IsString(reasoning)) reasoning_chars += strlen(reasoning->valuestring);
+            if (cJSON_IsString(content) && content->valuestring[0]) {
+                if (first_token) {
+                    first_token = false;
+                    ESP_LOGI(TAG, "LAT llm_first_token=%lld ms (reasoning chars before: %u)",
+                             (esp_timer_get_time() - t0) / 1000, (unsigned)reasoning_chars);
+                }
+                text_buf += content->valuestring;
+            }
+            cJSON_Delete(j);
+
+            // 맨 앞 감정 태그 처리
+            if (!emotion_done) {
+                std::string t = Trim(text_buf);
+                if (t.empty()) continue;
+                if (t[0] == '[') {
+                    size_t close = t.find(']');
+                    if (close == std::string::npos) {
+                        if (t.size() < 20) continue;  // 태그가 아직 덜 옴
+                        emotion_done = true;
+                    } else {
+                        std::string emo = t.substr(1, close - 1);
+                        if (IsKnownEmotion(emo)) first_emotion = emo;  // 첫 문장을 말하기 시작할 때 바꾼다
+                        text_buf = t.substr(close + 1);
+                        emotion_done = true;
+                    }
+                } else {
+                    emotion_done = true;
+                }
+            }
+            // 문장 단위로 잘라서 TTS로
+            size_t end;
+            while ((end = FindSentenceEnd(text_buf, first_sentence)) != std::string::npos) {
+                std::string sentence = text_buf.substr(0, end);
+                text_buf.erase(0, end);
+                if (Trim(sentence).empty()) continue;
+                {
+                    std::string plain = sentence;
+                    StripEmotionTags(plain);
+                    full_reply += plain;
+                }
+                push_sentence(sentence, false);
+                first_sentence = false;
+            }
+        }
+    }
+    // [DONE] 이후 남은 본문을 읽어 연결을 재사용할 수 있는 상태로 만든다
+    if (done) {
+        while (true) {
+            auto r = http->Read(buf, sizeof(buf));
+            if (!r || *r <= 0) break;
+        }
+    } else {
+        http->Close();
+    }
+    full_reply += text_buf;
+    push_sentence(text_buf, true);
+    ESP_LOGI(TAG, "LAT llm_total=%lld ms", (esp_timer_get_time() - t0) / 1000);
+
+    std::string reply = Trim(full_reply);
+    ESP_LOGI(TAG, "<< %s", reply.c_str());
+    if (!reply.empty() && IsCurrent(turn)) {
+        std::lock_guard<std::mutex> lock(history_mutex_);
+        history_.emplace_back(user_text, reply);
+        while (history_.size() > kHistoryTurns) history_.pop_front();
+    }
+    if (!reply.empty()) {
+        std::lock_guard<std::mutex> lock(memory_mutex_);
+        session_log_.push_back("아이: " + user_text);
+        session_log_.push_back("스택짱: " + reply);
+        while (session_log_.size() > 40) session_log_.erase(session_log_.begin());
+    }
+}
+
+void DirectProtocol::RequestMemoryUpdate() {
+    {
+        std::lock_guard<std::mutex> lock(memory_mutex_);
+        if (session_log_.empty()) return;
+        memory_update_pending_ = true;
+    }
+    { std::lock_guard<std::mutex> lock(mutex_); }  // 대기 직전의 MemoryLoop가 알림을 놓치지 않게
+    cv_.notify_all();
+}
+
+void DirectProtocol::MemoryLoop() {
+    while (true) {
+        std::string dialog;
+        {
+            std::unique_lock<std::mutex> lock(mutex_);
+            cv_.wait(lock, [this]() {
+                std::lock_guard<std::mutex> l2(memory_mutex_);
+                return stop_ || memory_update_pending_;
+            });
+            if (stop_) return;
+        }
+        {
+            std::lock_guard<std::mutex> lock(memory_mutex_);
+            memory_update_pending_ = false;
+            for (auto& line : session_log_) dialog += line + "\n";
+            session_log_.clear();
+        }
+        if (!dialog.empty()) UpdateMemory(dialog);
+    }
+}
+
+void DirectProtocol::UpdateMemory(const std::string& dialog) {
+    int64_t t0 = esp_timer_get_time();
+    std::string old_memory;
+    {
+        std::lock_guard<std::mutex> lock(memory_mutex_);
+        old_memory = memory_;
+    }
+    std::string now = CurrentTimeText();
+
+    cJSON* root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "model", config_.llm_model.c_str());
+    cJSON_AddBoolToObject(root, "stream", false);
+    cJSON_AddNumberToObject(root, "max_tokens", 700);
+    if (thinking_param_ok_) {
+        cJSON* thinking = cJSON_AddObjectToObject(root, "thinking");
+        cJSON_AddStringToObject(thinking, "type", "disabled");
+    }
+    cJSON* msgs = cJSON_AddArrayToObject(root, "messages");
+    auto add = [msgs](const char* role, const std::string& content) {
+        cJSON* m = cJSON_CreateObject();
+        cJSON_AddStringToObject(m, "role", role);
+        cJSON_AddStringToObject(m, "content", content.c_str());
+        cJSON_AddItemToArray(msgs, m);
+    };
+    add("system",
+        "너는 어린아이와 대화하는 로봇 스택짱의 기억을 정리하는 비서야.\n"
+        "기존 메모와 방금 나눈 대화를 보고, 앞으로 이 아이와 대화할 때 도움이 될 내용만 남겨 새 메모를 써.\n"
+        "담을 것: 이름, 나이, 좋아하는 것과 싫어하는 것, 가족과 친구, 최근 있었던 일(날짜와 함께), 아이와 한 약속.\n"
+        "확실하지 않은 추측은 쓰지 마. 오래되었거나 사소한 건 지워. 기존 메모의 내용과 다르면 최신 대화를 따라.\n"
+        "한국어로 '- '로 시작하는 짧은 줄들로, 전체 600자 이내로 써. 메모 내용만 출력해. 남길 게 없으면 기존 메모를 그대로 출력해.");
+    std::string user = "오늘: " + (now.empty() ? std::string("알 수 없음") : now) +
+                       "\n\n[기존 메모]\n" + (old_memory.empty() ? std::string("(없음)") : old_memory) +
+                       "\n\n[방금 나눈 대화]\n" + dialog;
+    add("user", user);
+    char* js = cJSON_PrintUnformatted(root);
+    std::string body = js ? js : "";
+    if (js) cJSON_free(js);
+    cJSON_Delete(root);
+
+    auto network = Board::GetInstance().GetNetwork();
+    if (!memory_http_) {
+        memory_http_ = network->CreateHttp(4);
+        memory_http_->SetKeepAlive(false);
+    }
+    auto& http = memory_http_;
+    http->SetTimeout(20000);
+    http->SetHeader("Authorization", "Bearer " + config_.deepseek_key);
+    http->SetHeader("Content-Type", "application/json");
+    http->SetContent(std::move(body));
+    if (!http->Open("POST", kDeepseekUrl)) {
+        ESP_LOGW(TAG, "Memory update: open failed");
+        http->Close();
+        return;
+    }
+    auto status = http->GetStatusCode();
+    std::string resp = http->ReadAll();
+    http->Close();
+    if (!status || *status != 200) {
+        ESP_LOGW(TAG, "Memory update: status %d %.160s", status ? *status : -1, resp.c_str());
+        return;
+    }
+    cJSON* j = cJSON_Parse(resp.c_str());
+    auto choices = j ? cJSON_GetObjectItem(j, "choices") : nullptr;
+    auto c0 = choices ? cJSON_GetArrayItem(choices, 0) : nullptr;
+    auto msg = c0 ? cJSON_GetObjectItem(c0, "message") : nullptr;
+    auto content = msg ? cJSON_GetObjectItem(msg, "content") : nullptr;
+    std::string memo = cJSON_IsString(content) ? Trim(content->valuestring) : "";
+    if (j) cJSON_Delete(j);
+    if (memo.empty()) return;
+    // NVS 문자열 한도(4000바이트) 안으로. UTF-8 글자 중간에서 자르지 않는다
+    const size_t kMaxBytes = 2400;
+    if (memo.size() > kMaxBytes) {
+        size_t cut = kMaxBytes;
+        while (cut > 0 && ((unsigned char)memo[cut] & 0xC0) == 0x80) cut--;
+        memo.resize(cut);
+    }
+    {
+        std::lock_guard<std::mutex> lock(memory_mutex_);
+        memory_ = memo;
+    }
+    Settings settings("direct", true);
+    settings.SetString("memory", memo);
+    ESP_LOGI(TAG, "Memory updated in %lld ms (%u bytes):\n%s", (esp_timer_get_time() - t0) / 1000,
+             (unsigned)memo.size(), memo.c_str());
+}
+
+void DirectProtocol::TtsLoop() {
+    while (true) {
+        Sentence job;
+        {
+            std::unique_lock<std::mutex> lock(mutex_);
+            cv_.wait(lock, [this]() { return stop_ || !tts_jobs_.empty(); });
+            if (stop_) return;
+            job = std::move(tts_jobs_.front());
+            tts_jobs_.pop_front();
+        }
+        if (job.turn == 0) {
+            // Google TTS 연결 예열 + 키 확인 (한국어 음성 목록 조회)
+            auto network = Board::GetInstance().GetNetwork();
+            if (!tts_http_) {
+                tts_http_ = network->CreateHttp(3);
+                tts_http_->SetKeepAlive(true);
+            }
+            int64_t t0 = esp_timer_get_time();
+            tts_http_->SetTimeout(10000);
+            tts_http_->SetHeader("X-Goog-Api-Key", config_.google_tts_key);
+            if (tts_http_->Open("GET", "https://texttospeech.googleapis.com/v1/voices?languageCode=ko-KR")) {
+                auto st = tts_http_->GetStatusCode();
+                std::string body = tts_http_->ReadAll();
+                ESP_LOGI(TAG, "Warmup Google TTS status=%d in %lld ms", st ? *st : -1,
+                         (esp_timer_get_time() - t0) / 1000);
+                if (!st || *st != 200) {
+                    ESP_LOGE(TAG, "Google TTS: %.300s", body.c_str());
+                } else {
+                    // 사용할 수 있는 한국어 음성 이름을 로그로 남긴다
+                    cJSON* j = cJSON_Parse(body.c_str());
+                    auto voices = j ? cJSON_GetObjectItem(j, "voices") : nullptr;
+                    std::string names;
+                    cJSON* v = nullptr;
+                    cJSON_ArrayForEach(v, voices) {
+                        auto n = cJSON_GetObjectItem(v, "name");
+                        if (cJSON_IsString(n)) { names += n->valuestring; names += " "; }
+                    }
+                    if (j) cJSON_Delete(j);
+                    ESP_LOGI(TAG, "ko-KR voices: %s", names.c_str());
+                }
+            } else {
+                tts_http_->Close();
+            }
+            continue;
+        }
+        if (!IsCurrent(job.turn)) continue;
+        if (job.text.empty() || !Synthesize(job.turn, job.text, job.last, job.emotion)) {
+            if (job.last) {
+                // 마지막 표시만 넘겨서 재생 쪽이 턴을 끝낼 수 있게 한다
+                std::lock_guard<std::mutex> lock(mutex_);
+                Chunk c;
+                c.turn = job.turn;
+                c.last = true;
+                chunks_.push_back(std::move(c));
+                cv_.notify_all();
+            }
+        }
+    }
+}
+
+bool DirectProtocol::Synthesize(uint32_t turn, const std::string& text, bool last,
+                                const std::string& emotion) {
+    int64_t t0 = esp_timer_get_time();
+    auto network = Board::GetInstance().GetNetwork();
+    if (!tts_http_) {
+        tts_http_ = network->CreateHttp(3);
+        tts_http_->SetKeepAlive(true);
+    }
+    auto& http = tts_http_;
+
+    auto make_body = [&](const std::string& voice_name) {
+        cJSON* root = cJSON_CreateObject();
+        cJSON* input = cJSON_AddObjectToObject(root, "input");
+        cJSON_AddStringToObject(input, "text", text.c_str());
+        cJSON* voice = cJSON_AddObjectToObject(root, "voice");
+        cJSON_AddStringToObject(voice, "languageCode", "ko-KR");
+        cJSON_AddStringToObject(voice, "name", voice_name.c_str());
+        cJSON* ac = cJSON_AddObjectToObject(root, "audioConfig");
+        cJSON_AddStringToObject(ac, "audioEncoding", "OGG_OPUS");
+        cJSON_AddNumberToObject(ac, "sampleRateHertz", kTtsSampleRate);
+        char* s = cJSON_PrintUnformatted(root);
+        std::string body = s ? s : "";
+        if (s) cJSON_free(s);
+        cJSON_Delete(root);
+        return body;
+    };
+
+    // 재사용하려던 연결을 서버가 이미 닫았을 수 있으므로 한 번은 새 연결로 다시 시도한다
+    auto request = [&](const std::string& body, std::string& resp) -> NetworkResult<int> {
+        NetworkResult<int> status = std::unexpected(NetworkError::InvalidArgument());
+        for (int attempt = 0; attempt < 2; attempt++) {
+            http->SetTimeout(10000);
+            http->SetHeader("Content-Type", "application/json");
+            http->SetHeader("X-Goog-Api-Key", config_.google_tts_key);
+            http->SetContent(std::string(body));
+            if (!http->Open("POST", kTtsUrl)) {
+                ESP_LOGW(TAG, "TTS open failed (attempt %d)", attempt + 1);
+                http->Close();
+                continue;
+            }
+            status = http->GetStatusCode();
+            resp = http->ReadAll();
+            if (status) break;  // HTTP 응답을 받았으면 상태 코드와 상관없이 재시도하지 않는다
+            ESP_LOGW(TAG, "TTS no response (attempt %d)", attempt + 1);
+            http->Close();
+        }
+        return status;
+    };
+
+    std::string resp;
+    auto status = request(make_body(config_.tts_voice), resp);
+    if (status && *status == 400 && config_.tts_voice != kFallbackVoice) {
+        // 음성 이름이 틀렸거나 이 음성이 요청 형식을 받지 않는 경우: 기본 음성으로 바꿔서 계속 말하게 한다
+        ESP_LOGW(TAG, "TTS voice %s rejected (%.160s), falling back to %s", config_.tts_voice.c_str(),
+                 resp.c_str(), kFallbackVoice);
+        config_.tts_voice = kFallbackVoice;
+        status = request(make_body(config_.tts_voice), resp);
+    }
+    if (!status || *status != 200) {
+        ESP_LOGE(TAG, "TTS status %d: %.200s", status ? *status : -1, resp.c_str());
+        http->Close();
+        return false;
+    }
+    int64_t t_http = esp_timer_get_time();
+
+    cJSON* j = cJSON_Parse(resp.c_str());
+    resp.clear();
+    resp.shrink_to_fit();
+    auto ac_item = j ? cJSON_GetObjectItem(j, "audioContent") : nullptr;
+    if (!cJSON_IsString(ac_item)) {
+        ESP_LOGE(TAG, "TTS response has no audioContent");
+        if (j) cJSON_Delete(j);
+        return false;
+    }
+    auto ogg = Base64Decode(ac_item->valuestring, strlen(ac_item->valuestring));
+    cJSON_Delete(j);
+    if (!IsCurrent(turn)) return true;
+
+    Chunk chunk;
+    chunk.turn = turn;
+    chunk.sample_rate = kTtsSampleRate;
+    chunk.data.reserve(ogg.size());   // 1KB 넘는 할당은 PSRAM으로 간다
+    chunk.frames.reserve(512);
+    OggDemuxer demuxer;
+    demuxer.OnPacket([&](const uint8_t* data, int sample_rate, int frame_duration_ms, size_t size) {
+        chunk.sample_rate = sample_rate;
+        chunk.frames.push_back({(uint32_t)chunk.data.size(), (uint16_t)size, (uint16_t)frame_duration_ms});
+        chunk.data.insert(chunk.data.end(), data, data + size);
+    });
+    demuxer.Reset();
+    demuxer.Process(ogg.data(), ogg.size());
+    ogg.clear();
+    ogg.shrink_to_fit();
+    ESP_LOGI(TAG, "LAT tts http=%lld ms total=%lld ms packets=%u chars=%u",
+             (t_http - t0) / 1000, (esp_timer_get_time() - t0) / 1000,
+             (unsigned)chunk.frames.size(), (unsigned)text.size());
+    if (chunk.frames.empty()) return false;
+    chunk.last = last;
+    chunk.emotion = emotion;
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!IsCurrent(turn)) return true;
+    chunks_.push_back(std::move(chunk));
+    cv_.notify_all();
+    return true;
+}
+
+void DirectProtocol::PlayerLoop() {
+    auto& app = Application::GetInstance();
+    uint32_t playing_turn = 0;
+    int64_t play_start_us = 0;  // 재생 기준 시각
+    int64_t queued_us = 0;      // 기준 시각 이후 넣은 오디오 길이
+
+    while (true) {
+        Chunk c;
+        {
+            std::unique_lock<std::mutex> lock(mutex_);
+            cv_.wait(lock, [this]() { return stop_ || !chunks_.empty(); });
+            if (stop_) return;
+            c = std::move(chunks_.front());
+            chunks_.pop_front();
+        }
+        if (!IsCurrent(c.turn)) continue;
+
+        if (c.turn != playing_turn) {
+            // 새 턴 시작: 말하기 상태로 바꾸고, 상태가 바뀔 때까지 잠깐 기다린다
+            playing_turn = c.turn;
+            EmitJson("tts", "state", "start");
+            for (int i = 0; i < 50 && app.GetDeviceState() != kDeviceStateSpeaking; i++) {
+                vTaskDelay(pdMS_TO_TICKS(10));
+            }
+            play_start_us = esp_timer_get_time();
+            queued_us = 0;
+        }
+        if (!c.emotion.empty() && IsCurrent(c.turn)) {
+            // 이 문장을 말하기 시작할 때 표정을 바꾼다
+            EmitJson("llm", "emotion", c.emotion.c_str());
+        }
+
+        for (auto& f : c.frames) {
+            if (!IsCurrent(c.turn)) break;
+            int64_t elapsed = esp_timer_get_time() - play_start_us;
+            if (queued_us < elapsed) {
+                // 앞 문장과 사이가 떠서 재생이 비었으면 기준을 다시 잡는다 (몰아 넣다가 큐가 넘치지 않게)
+                play_start_us = esp_timer_get_time() - queued_us;
+            }
+            // 재생 큐가 넘치지 않게 실제 재생 속도에 맞춰 넣는다
+            while (IsCurrent(c.turn) &&
+                   queued_us - (esp_timer_get_time() - play_start_us) > kPlaybackLeadUs) {
+                vTaskDelay(pdMS_TO_TICKS(10));
+            }
+            if (!IsCurrent(c.turn)) break;
+            if (on_incoming_audio_) {
+                auto pkt = std::make_unique<AudioStreamPacket>();
+                pkt->sample_rate = c.sample_rate;
+                pkt->frame_duration = f.duration_ms;
+                pkt->payload.assign(c.data.begin() + f.offset, c.data.begin() + f.offset + f.size);
+                on_incoming_audio_(std::move(pkt));
+            }
+            queued_us += (int64_t)f.duration_ms * 1000;
+        }
+
+        if (c.last && IsCurrent(c.turn)) {
+            // 앞서 넣은 음성이 다 재생될 때쯤 말하기를 끝낸다 (듣기 전환은 재생 큐가 빈 뒤에 일어남)
+            EmitJson("tts", "state", "stop");
+        }
+    }
+}
