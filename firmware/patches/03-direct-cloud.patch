+
+void DirectProtocol::EmitJson(const char* type, const char* key1, const char* val1,
+                              const char* key2, const char* val2) {
+    if (!on_incoming_json_) return;
+    cJSON* root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "type", type);
+    if (key1) cJSON_AddStringToObject(root, key1, val1);
+    if (key2) cJSON_AddStringToObject(root, key2, val2);
+    on_incoming_json_(root);
+    cJSON_Delete(root);
+}
+
+void DirectProtocol::OnAsrMessage(const char* data, size_t len) {
+    last_incoming_time_ = std::chrono::steady_clock::now();
+    cJSON* root = cJSON_ParseWithLength(data, len);
+    if (!root) return;
+    auto type = cJSON_GetObjectItem(root, "type");
+    if (cJSON_IsString(type)) {
+        if (strcmp(type->valuestring, "Results") == 0) {
+            bool is_final = cJSON_IsTrue(cJSON_GetObjectItem(root, "is_final"));
+            bool speech_final = cJSON_IsTrue(cJSON_GetObjectItem(root, "speech_final"));
+            bool from_finalize = cJSON_IsTrue(cJSON_GetObjectItem(root, "from_finalize"));
+            const char* transcript = nullptr;
+            auto channel = cJSON_GetObjectItem(root, "channel");
+            auto alts = channel ? cJSON_GetObjectItem(channel, "alternatives") : nullptr;
+            auto alt0 = alts ? cJSON_GetArrayItem(alts, 0) : nullptr;
+            auto t = alt0 ? cJSON_GetObjectItem(alt0, "transcript") : nullptr;
+            if (cJSON_IsString(t)) transcript = t->valuestring;
+
+            if (is_final && transcript && transcript[0] && listening_) {
+                std::lock_guard<std::mutex> lock(asr_mutex_);
+                if (!utterance_.empty()) utterance_ += " ";
+                utterance_ += transcript;
+            }
+            if (speech_final || from_finalize) FinishUtterance();
+        } else if (strcmp(type->valuestring, "UtteranceEnd") == 0) {
+            FinishUtterance();
+        } else if (strcmp(type->valuestring, "Error") == 0 ||
+                   strcmp(type->valuestring, "error") == 0) {
+            char* s = cJSON_PrintUnformatted(root);
+            ESP_LOGE(TAG, "Deepgram error: %s", s ? s : "");
+            if (s) cJSON_free(s);
+        }
+    }
+    cJSON_Delete(root);
+}
+
+void DirectProtocol::FinishUtterance() {
+    std::string text;
+    {
+        std::lock_guard<std::mutex> lock(asr_mutex_);
+        if (!listening_ || utterance_.empty()) return;
+        text = Trim(utterance_);
+        utterance_.clear();
+        listening_ = false;
+    }
+    if (text.empty()) {
+        listening_ = true;
+        return;
+    }
+    EmitJson("stt", "text", text.c_str());
+
+    uint32_t turn = turn_.fetch_add(1) + 1;
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        llm_jobs_.emplace_back(turn, text);
+    }
+    cv_.notify_all();
+}
+
+std::string DirectProtocol::BuildLlmBody(const std::string& user_text) {
+    cJSON* root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "model", config_.llm_model.c_str());
+    cJSON_AddBoolToObject(root, "stream", true);
+    cJSON_AddNumberToObject(root, "max_tokens", 300);
+    cJSON* msgs = cJSON_AddArrayToObject(root, "messages");
+    auto add = [msgs](const char* role, const std::string& content) {
+        cJSON* m = cJSON_CreateObject();
+        cJSON_AddStringToObject(m, "role", role);
+        cJSON_AddStringToObject(m, "content", content.c_str());
+        cJSON_AddItemToArray(msgs, m);
+    };
+    add("system", kSystemPrompt);
+    {
+        std::lock_guard<std::mutex> lock(history_mutex_);
+        for (auto& h : history_) {
+            add("user", h.first);
+            add("assistant", h.second);
+        }
+    }
+    add("user", user_text);
+    char* s = cJSON_PrintUnformatted(root);
+    std::string body = s ? s : "";
+    if (s) cJSON_free(s);
+    cJSON_Delete(root);
+    return body;
+}
+
+void DirectProtocol::LlmLoop() {
+    while (true) {
+        std::pair<uint32_t, std::string> job;
+        {
+            std::unique_lock<std::mutex> lock(mutex_);
+            cv_.wait(lock, [this]() { return stop_ || !llm_jobs_.empty(); });
+            if (stop_) return;
+            job = std::move(llm_jobs_.front());
+            llm_jobs_.pop_front();
+        }
+        if (IsCurrent(job.first)) RunLlm(job.first, job.second);
+    }
+}
+
+void DirectProtocol::RunLlm(uint32_t turn, const std::string& user_text) {
+    int64_t t0 = esp_timer_get_time();
+    auto network = Board::GetInstance().GetNetwork();
+    if (!llm_http_) {
+        llm_http_ = network->CreateHttp(2);
+        llm_http_->SetKeepAlive(true);
+    }
+    auto& http = llm_http_;
+    http->SetTimeout(15000);
+    http->SetHeader("Authorization", "Bearer " + config_.deepseek_key);
+    http->SetHeader("Content-Type", "application/json");
+    http->SetHeader("Accept", "text/event-stream");
+    http->SetContent(BuildLlmBody(user_text));
+
+    auto finish_with_error = [&](const char* msg) {
+        ESP_LOGE(TAG, "%s", msg);
+        http->Close();
+        if (IsCurrent(turn)) {
+            std::lock_guard<std::mutex> lock(mutex_);
+            tts_jobs_.push_back({turn, "죄송해요, 지금은 대답하기 어려워요.", true});
+            cv_.notify_all();
+        }
+    };
+
+    if (!http->Open("POST", kDeepseekUrl)) {
+        finish_with_error("DeepSeek open failed");
+        return;
+    }
+    auto status = http->GetStatusCode();
+    if (!status || *status != 200) {
+        std::string body = http->ReadAll();
+        ESP_LOGE(TAG, "DeepSeek status %d: %.200s", status ? *status : -1, body.c_str());
+        finish_with_error("DeepSeek request failed");
+        return;
+    }
+    ESP_LOGI(TAG, "LAT llm_headers=%lld ms", (esp_timer_get_time() - t0) / 1000);
+
+    std::string line_buf, text_buf, full_reply;
+    bool emotion_done = false, first_sentence = true, first_token = true;
+    char buf[512];
+    bool done = false;
+
+    auto push_sentence = [&](const std::string& raw, bool last) {
+        std::string s = CleanForSpeech(raw);
+        if (s.empty() && !last) return;
+        std::lock_guard<std::mutex> lock(mutex_);
+        tts_jobs_.push_back({turn, s, last});
+        cv_.notify_all();
+    };
+
+    while (!done) {
+        if (!IsCurrent(turn)) {  // 중간에 끊김
+            http->Close();
+            return;
+        }
+        auto r = http->Read(buf, sizeof(buf));
+        if (!r || *r <= 0) break;
+        line_buf.append(buf, *r);
+        size_t pos;
+        while ((pos = line_buf.find('\n')) != std::string::npos) {
+            std::string line = Trim(line_buf.substr(0, pos));
+            line_buf.erase(0, pos + 1);
+            if (line.rfind("data:", 0) != 0) continue;  // ": keep-alive" 등
+            std::string payload = Trim(line.substr(5));
+            if (payload == "[DONE]") {
+                done = true;
+                break;
+            }
+            cJSON* j = cJSON_Parse(payload.c_str());
+            if (!j) continue;
+            auto choices = cJSON_GetObjectItem(j, "choices");
+            auto c0 = choices ? cJSON_GetArrayItem(choices, 0) : nullptr;
+            auto delta = c0 ? cJSON_GetObjectItem(c0, "delta") : nullptr;
+            auto content = delta ? cJSON_GetObjectItem(delta, "content") : nullptr;
+            if (cJSON_IsString(content) && content->valuestring[0]) {
+                if (first_token) {
+                    first_token = false;
+                    ESP_LOGI(TAG, "LAT llm_first_token=%lld ms", (esp_timer_get_time() - t0) / 1000);
+                }
+                text_buf += content->valuestring;
+            }
+            cJSON_Delete(j);
+
+            // 맨 앞 감정 태그 처리
+            if (!emotion_done) {
+                std::string t = Trim(text_buf);
+                if (t.empty()) continue;
+                if (t[0] == '[') {
+                    size_t close = t.find(']');
+                    if (close == std::string::npos) {
+                        if (t.size() < 20) continue;  // 태그가 아직 덜 옴
+                        emotion_done = true;
+                    } else {
+                        std::string emo = t.substr(1, close - 1);
+                        if (IsKnownEmotion(emo)) EmitJson("llm", "emotion", emo.c_str());
+                        text_buf = t.substr(close + 1);
+                        emotion_done = true;
+                    }
+                } else {
+                    emotion_done = true;
+                }
+            }
+            // 문장 단위로 잘라서 TTS로
+            size_t end;
+            while ((end = FindSentenceEnd(text_buf, first_sentence)) != std::string::npos) {
+                std::string sentence = text_buf.substr(0, end);
+                text_buf.erase(0, end);
+                if (Trim(sentence).empty()) continue;
+                full_reply += sentence;
+                push_sentence(sentence, false);
+                first_sentence = false;
+            }
+        }
+    }
+    // [DONE] 이후 남은 본문을 읽어 연결을 재사용할 수 있는 상태로 만든다
+    if (done) {
+        while (true) {
+            auto r = http->Read(buf, sizeof(buf));
+            if (!r || *r <= 0) break;
+        }
+    } else {
+        http->Close();
+    }
+    full_reply += text_buf;
+    push_sentence(text_buf, true);
+    ESP_LOGI(TAG, "LAT llm_total=%lld ms", (esp_timer_get_time() - t0) / 1000);
+
+    std::string reply = Trim(full_reply);
+    if (!reply.empty() && IsCurrent(turn)) {
+        std::lock_guard<std::mutex> lock(history_mutex_);
+        history_.emplace_back(user_text, reply);
+        while (history_.size() > kHistoryTurns) history_.pop_front();
+    }
+}
+
+void DirectProtocol::TtsLoop() {
+    while (true) {
+        Sentence job;
+        {
+            std::unique_lock<std::mutex> lock(mutex_);
+            cv_.wait(lock, [this]() { return stop_ || !tts_jobs_.empty(); });
+            if (stop_) return;
+            job = std::move(tts_jobs_.front());
+            tts_jobs_.pop_front();
+        }
+        if (!IsCurrent(job.turn)) continue;
+        if (job.text.empty() || !Synthesize(job.turn, job.text, job.last)) {
+            if (job.last) {
+                // 마지막 표시만 넘겨서 재생 쪽이 턴을 끝낼 수 있게 한다
+                std::lock_guard<std::mutex> lock(mutex_);
+                packets_.push_back({job.turn, kTtsSampleRate, 20, {}, true});
+                cv_.notify_all();
+            }
+        }
+    }
+}
+
+bool DirectProtocol::Synthesize(uint32_t turn, const std::string& text, bool last) {
+    int64_t t0 = esp_timer_get_time();
+    auto network = Board::GetInstance().GetNetwork();
+    if (!tts_http_) {
+        tts_http_ = network->CreateHttp(3);
+        tts_http_->SetKeepAlive(true);
+    }
+    auto& http = tts_http_;
+
+    cJSON* root = cJSON_CreateObject();
+    cJSON* input = cJSON_AddObjectToObject(root, "input");
+    cJSON_AddStringToObject(input, "text", text.c_str());
+    cJSON* voice = cJSON_AddObjectToObject(root, "voice");
+    cJSON_AddStringToObject(voice, "languageCode", "ko-KR");
+    cJSON_AddStringToObject(voice, "name", config_.tts_voice.c_str());
+    cJSON* ac = cJSON_AddObjectToObject(root, "audioConfig");
+    cJSON_AddStringToObject(ac, "audioEncoding", "OGG_OPUS");
+    cJSON_AddNumberToObject(ac, "sampleRateHertz", kTtsSampleRate);
+    char* s = cJSON_PrintUnformatted(root);
+    std::string body = s ? s : "";
+    if (s) cJSON_free(s);
+    cJSON_Delete(root);
+
+    http->SetTimeout(10000);
+    http->SetHeader("Content-Type", "application/json");
+    http->SetHeader("X-Goog-Api-Key", config_.google_tts_key);
+    http->SetContent(std::move(body));
+    if (!http->Open("POST", kTtsUrl)) {
+        ESP_LOGE(TAG, "TTS open failed");
+        http->Close();
+        return false;
+    }
+    auto status = http->GetStatusCode();
+    std::string resp = http->ReadAll();
+    if (!status || *status != 200) {
+        ESP_LOGE(TAG, "TTS status %d: %.200s", status ? *status : -1, resp.c_str());
+        http->Close();
+        return false;
+    }
+    int64_t t_http = esp_timer_get_time();
+
+    cJSON* j = cJSON_Parse(resp.c_str());
+    resp.clear();
+    resp.shrink_to_fit();
+    auto ac_item = j ? cJSON_GetObjectItem(j, "audioContent") : nullptr;
+    if (!cJSON_IsString(ac_item)) {
+        ESP_LOGE(TAG, "TTS response has no audioContent");
+        if (j) cJSON_Delete(j);
+        return false;
+    }
+    auto ogg = Base64Decode(ac_item->valuestring, strlen(ac_item->valuestring));
+    cJSON_Delete(j);
+    if (!IsCurrent(turn)) return true;
+
+    std::vector<Packet> out;
+    OggDemuxer demuxer;
+    demuxer.OnPacket([&](const uint8_t* data, int sample_rate, int frame_duration_ms, size_t size) {
+        out.push_back({turn, sample_rate, frame_duration_ms,
+                       std::vector<uint8_t>(data, data + size), false});
+    });
+    demuxer.Reset();
+    demuxer.Process(ogg.data(), ogg.size());
+    ESP_LOGI(TAG, "LAT tts http=%lld ms total=%lld ms packets=%u chars=%u",
+             (t_http - t0) / 1000, (esp_timer_get_time() - t0) / 1000, (unsigned)out.size(),
+             (unsigned)text.size());
+    if (out.empty()) return false;
+    out.back().last = last;
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!IsCurrent(turn)) return true;
+    for (auto& p : out) packets_.push_back(std::move(p));
+    cv_.notify_all();
+    return true;
+}
+
+void DirectProtocol::PlayerLoop() {
+    auto& app = Application::GetInstance();
+    uint32_t playing_turn = 0;
+    int64_t play_start_us = 0;  // 이번 턴에서 첫 패킷을 넣은 시각
+    int64_t queued_us = 0;      // 이번 턴에서 넣은 오디오 총 길이
+
+    while (true) {
+        Packet p;
+        {
+            std::unique_lock<std::mutex> lock(mutex_);
+            cv_.wait(lock, [this]() { return stop_ || !packets_.empty(); });
+            if (stop_) return;
+            p = std::move(packets_.front());
+            packets_.pop_front();
+        }
+        if (!IsCurrent(p.turn)) continue;
+
+        if (p.turn != playing_turn) {
+            // 새 턴 시작: 말하기 상태로 바꾸고, 상태가 바뀔 때까지 잠깐 기다린다
+            playing_turn = p.turn;
+            queued_us = 0;
+            EmitJson("tts", "state", "start");
+            for (int i = 0; i < 50 && app.GetDeviceState() != kDeviceStateSpeaking; i++) {
+                vTaskDelay(pdMS_TO_TICKS(10));
+            }
+            play_start_us = esp_timer_get_time();
+        }
+
+        if (!p.payload.empty()) {
+            // 재생 큐가 넘치지 않게 실제 재생 속도에 맞춰 넣는다
+            while (IsCurrent(p.turn) &&
+                   queued_us - (esp_timer_get_time() - play_start_us) > kPlaybackLeadUs) {
+                vTaskDelay(pdMS_TO_TICKS(10));
+            }
+            if (!IsCurrent(p.turn)) continue;
+            if (on_incoming_audio_) {
+                auto pkt = std::make_unique<AudioStreamPacket>();
+                pkt->sample_rate = p.sample_rate;
+                pkt->frame_duration = p.frame_duration;
+                pkt->payload = std::move(p.payload);
+                on_incoming_audio_(std::move(pkt));
+            }
+            queued_us += (int64_t)p.frame_duration * 1000;
+        }
+
+        if (p.last && IsCurrent(p.turn)) {
+            // 앞서 넣은 음성이 다 재생될 때쯤 말하기를 끝낸다 (듣기 전환은 재생 큐가 빈 뒤에 일어남)
+            EmitJson("tts", "state", "stop");
+        }
+    }
+}
