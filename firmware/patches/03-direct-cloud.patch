+// direct-cloud: 서버 없이 기기에서 Deepgram(ASR) / DeepSeek(LLM) / Google TTS를 직접 호출한다.
+// 기존 Protocol 인터페이스를 그대로 구현하므로 Application 쪽 흐름(상태, 표정, 재생)은 바뀌지 않는다.
+#ifndef DIRECT_PROTOCOL_H
+#define DIRECT_PROTOCOL_H
+
+#include "protocol.h"
+
+#include <web_socket.h>
+#include <http.h>
+#include <esp_timer.h>
+
+#include <atomic>
+#include <condition_variable>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+struct DirectConfig {
+    std::string deepgram_key;
+    std::string deepseek_key;
+    std::string google_tts_key;
+    std::string llm_model;
+    std::string tts_voice;
+    std::string memory;  // 아이에 대한 기억 메모 (NVS "memory")
+    bool IsComplete() const {
+        return !deepgram_key.empty() && !deepseek_key.empty() && !google_tts_key.empty();
+    }
+    static DirectConfig Load();
+};
+
+class DirectProtocol : public Protocol {
+public:
+    DirectProtocol();
+    ~DirectProtocol() override;
+
+    bool Start() override;
+    bool OpenAudioChannel() override;
+    void CloseAudioChannel(bool send_goodbye = true) override;
+    bool IsAudioChannelOpened() const override;
+    bool SendAudio(std::unique_ptr<AudioStreamPacket> packet) override;
+    void SendWakeWordDetected(const std::string& wake_word) override;
+    void SendStartListening(ListeningMode mode) override;
+    void SendStopListening() override;
+    void SendAbortSpeaking(AbortReason reason) override;
+    void SendMcpMessage(const std::string& message) override;
+
+private:
+    struct Sentence {
+        uint32_t turn;
+        std::string text;
+        bool last;
+        std::string emotion;  // 이 문장을 말하기 시작할 때 바꿀 표정 (없으면 그대로)
+    };
+    // 한 문장 분량의 음성. 프레임 수백 개를 따로 할당하면 내부 RAM이 바닥나므로
+    // 큰 버퍼 하나(PSRAM으로 감)에 이어 붙이고 위치만 따로 둔다.
+    struct Frame {
+        uint32_t offset;
+        uint16_t size;
+        uint16_t duration_ms;
+    };
+    struct Chunk {
+        uint32_t turn = 0;
+        int sample_rate = 0;
+        std::vector<uint8_t> data;
+        std::vector<Frame> frames;
+        bool last = false;
+        std::string emotion;
+    };
+
+    DirectConfig config_;
