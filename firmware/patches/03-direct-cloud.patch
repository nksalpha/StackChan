+    std::atomic<int> asr_rate_{16000};        // 지금 Deepgram 연결의 샘플레이트
+    std::atomic<bool> slow_network_{false};   // 업로드가 실시간을 못 따라가면 다음 연결은 8kHz
+    int good_windows_ = 0;
+    std::atomic<bool> notice_pending_{false}; // 다음 대답 첫마디에 "인터넷이 느려" 안내
+    int64_t last_notice_us_ = 0;
+    void UploadLoop();
+
+    // 기억 메모: 대화 중에는 읽기만, 대화가 끝나면 뒤에서 갱신
+    std::mutex memory_mutex_;
