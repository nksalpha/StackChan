diff --git a/main/boards/m5stack/stackchan/reactions.h b/main/boards/m5stack/stackchan/reactions.h
new file mode 100644
index 0000000..aade8f8
--- /dev/null
+++ b/main/boards/m5stack/stackchan/reactions.h
@@ -0,0 +1,287 @@
+// direct-cloud: 터치·흔들기 반응과 대기 중 표정 변화
+//
+// - 터치 (FT6336, 0x38): 톡 치기 / 쓰다듬기(길게) / 간지럼(문지르기) / 여러 번 콕콕
+// - 흔들기 (BMI270, 0x69): 세게 흔들면 깜짝 → 어지러움
+// - 대기 중: 가끔 윙크나 편안한 표정, 오래 혼자 두면 졸린 얼굴
+//
+// 50ms마다 센서를 읽는 작은 태스크 하나로 동작한다. 표정 변경은 Application 메인 루프에 맡긴다.
+#pragma once
+
+#include "application.h"
+#include "display.h"
+#include "i2c_device.h"
+
+#include <esp_log.h>
+#include <esp_random.h>
+#include <esp_timer.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+
+#include <cmath>
+#include <functional>
+#include <string>
+
+// BMI270 설정 파일 (espressif/bmi270_sensor 부품에 들어 있는 8KB 바이너리)
+extern "C" const uint8_t bmi270_config_file[];
+
+namespace stackchan_reactions {
+
+static const char* const RTAG = "Reactions";
+
+// 터치 칩. 손가락 수와 첫 손가락 좌표만 읽는다.
+class TouchPanel : public I2cDevice {
+public:
+    TouchPanel(i2c_master_bus_handle_t bus, uint8_t addr) : I2cDevice(bus, addr) {}
+    bool Read(int& num, int& x, int& y) {
+        uint8_t buf[5] = {0};
+        ReadRegs(0x02, buf, sizeof(buf));
+        num = buf[0] & 0x0F;
+        x = ((buf[1] & 0x0F) << 8) | buf[2];
+        y = ((buf[3] & 0x0F) << 8) | buf[4];
+        return num <= 2;
+    }
+    uint8_t ChipId() { return ReadReg(0xA3); }
+};
+
+// 가속도만 쓰는 최소 BMI270 드라이버 (설정 파일을 올린 뒤 가속도계만 켠다)
+class Accel : public I2cDevice {
+public:
+    Accel(i2c_master_bus_handle_t bus, uint8_t addr) : I2cDevice(bus, addr) {}
+
+    bool Begin() {
+        if (ReadReg(0x00) != 0x24) {  // CHIP_ID
+            ESP_LOGW(RTAG, "BMI270 not found");
+            return false;
+        }
+        WriteReg(0x7E, 0xB6);  // soft reset
+        vTaskDelay(pdMS_TO_TICKS(5));
+        WriteReg(0x7C, 0x00);  // PWR_CONF: advanced power save off
+        vTaskDelay(pdMS_TO_TICKS(1));
+        WriteReg(0x59, 0x00);  // INIT_CTRL: start config load
+        const size_t kChunk = 64;
+        for (size_t off = 0; off < 8192; off += kChunk) {
+            WriteReg(0x5B, (uint8_t)((off / 2) & 0x0F));  // INIT_ADDR_0
+            WriteReg(0x5C, (uint8_t)((off / 2) >> 4));    // INIT_ADDR_1
+            WriteRegs(0x5E, bmi270_config_file + off, kChunk);  // INIT_DATA
+        }
+        WriteReg(0x59, 0x01);  // INIT_CTRL: done
+        vTaskDelay(pdMS_TO_TICKS(30));
+        uint8_t status = ReadReg(0x21) & 0x0F;  // INTERNAL_STATUS
+        if (status != 0x01) {
+            ESP_LOGW(RTAG, "BMI270 init status 0x%02X", status);
+            return false;
+        }
+        WriteReg(0x7D, 0x04);  // PWR_CTRL: accel on
+        WriteReg(0x40, 0xA8);  // ACC_CONF: 100Hz, normal, performance
+        WriteReg(0x41, 0x01);  // ACC_RANGE: ±4g (8192 LSB/g)
+        vTaskDelay(pdMS_TO_TICKS(10));
+        ESP_LOGI(RTAG, "BMI270 ready");
+        return true;
+    }
+
+    // 단위: g
+    void Read(float& x, float& y, float& z) {
+        uint8_t b[6];
+        ReadRegs(0x0C, b, 6);
+        x = (int16_t)(b[0] | (b[1] << 8)) / 8192.0f;
+        y = (int16_t)(b[2] | (b[3] << 8)) / 8192.0f;
+        z = (int16_t)(b[4] | (b[5] << 8)) / 8192.0f;
+    }
+};
+
+class Reactions {
+public:
+    void Start(i2c_master_bus_handle_t bus, std::function<void()> on_activity) {
+        on_activity_ = std::move(on_activity);
+        touch_ = new TouchPanel(bus, 0x38);
+        ESP_LOGI(RTAG, "Touch chip id 0x%02X", touch_->ChipId());
+        accel_ = new Accel(bus, 0x69);
+        has_accel_ = accel_->Begin();
+        xTaskCreate([](void* arg) { static_cast<Reactions*>(arg)->Loop(); }, "reactions", 4096,
+                    this, 2, nullptr);
+    }
+
+private:
+    TouchPanel* touch_ = nullptr;
+    Accel* accel_ = nullptr;
+    bool has_accel_ = false;
+    std::function<void()> on_activity_;
+
+    // 표정을 잠깐 바꿨다가 되돌리기
+    int64_t revert_at_us_ = 0;
+    std::string revert_to_;
+    std::string chained_;  // 첫 표정 뒤에 이어서 보여 줄 표정 (깜짝 → 어지러움)
+    int64_t chained_at_us_ = 0;
+
+    // 터치 상태
+    bool touching_ = false;
+    int64_t touch_start_us_ = 0;
+    int touch_x0_ = 0, touch_x_min_ = 0, touch_x_max_ = 0;
+    bool long_press_shown_ = false;
+    int64_t tap_times_[4] = {0};
+
+    // 흔들기 상태
+    int shake_hits_ = 0;
+    int64_t shake_window_us_ = 0;
+    int64_t last_shake_us_ = 0;
+
+    // 대기 상태
+    DeviceState last_state_ = kDeviceStateUnknown;
+    int64_t state_since_us_ = 0;
+    int64_t next_idle_fx_us_ = 0;
+    bool sleepy_ = false;
+
+    static int64_t Now() { return esp_timer_get_time(); }
+    static uint32_t Rand(uint32_t n) { return esp_random() % n; }
+
+    static void SetFace(const std::string& emotion) {
+        auto& app = Application::GetInstance();
+        app.Schedule([emotion]() {
+            auto display = Board::GetInstance().GetDisplay();
+            if (display) display->SetEmotion(emotion.c_str());
+        });
+    }
+
+    // 지금 상태에서 돌아갈 기본 얼굴
+    static std::string BaseFace(DeviceState s) {
+        return s == kDeviceStateSpeaking ? "happy" : "neutral";
+    }
+
+    static bool ReactionsAllowed(DeviceState s) {
+        return s == kDeviceStateIdle || s == kDeviceStateListening || s == kDeviceStateSpeaking ||
+               s == kDeviceStateConnecting;
+    }
+
+    void Show(const std::string& face, int ms, DeviceState s) {
+        SetFace(face);
+        revert_to_ = BaseFace(s);
+        revert_at_us_ = Now() + (int64_t)ms * 1000;
+        sleepy_ = false;
+        next_idle_fx_us_ = Now() + 15LL * 1000 * 1000;
+        if (on_activity_) on_activity_();
+    }
+
+    void Loop() {
+        int64_t last_accel_us = 0;
+        while (true) {
+            vTaskDelay(pdMS_TO_TICKS(50));
+            int64_t now = Now();
+            DeviceState state = Application::GetInstance().GetDeviceState();
+            if (state != last_state_) {
+                last_state_ = state;
+                state_since_us_ = now;
+                sleepy_ = false;
+                next_idle_fx_us_ = now + (15 + Rand(20)) * 1000000LL;
+                revert_at_us_ = 0;
+                chained_.clear();
+            }
+            bool allowed = ReactionsAllowed(state);
+
+            PollTouch(now, state, allowed);
+            if (has_accel_ && now - last_accel_us >= 50 * 1000) {
+                last_accel_us = now;
+                PollShake(now, state, allowed);
+            }
+
+            // 이어지는 표정 / 원래 얼굴로 되돌리기
+            if (!chained_.empty() && now >= chained_at_us_) {
+                SetFace(chained_);
+                chained_.clear();
+            } else if (revert_at_us_ && now >= revert_at_us_ && chained_.empty()) {
+                revert_at_us_ = 0;
+                if (ReactionsAllowed(state) && !touching_) SetFace(revert_to_);
+            }
+
+            // 대기 중: 가끔 표정 놀이, 오래 혼자면 졸림
+            if (state == kDeviceStateIdle && !touching_ && revert_at_us_ == 0 && chained_.empty()) {
+                if (!sleepy_ && now - state_since_us_ > 120LL * 1000 * 1000) {
+                    sleepy_ = true;
+                    SetFace("sleepy");
+                } else if (!sleepy_ && now >= next_idle_fx_us_) {
+                    static const char* kIdleFx[] = {"winking", "relaxed", "idle", "happy", "silly"};
+                    SetFace(kIdleFx[Rand(5)]);
+                    revert_to_ = "neutral";
+                    revert_at_us_ = now + (1200 + Rand(1500)) * 1000LL;
+                    next_idle_fx_us_ = now + (20 + Rand(25)) * 1000000LL;
+                }
+            }
+        }
+    }
+
+    void PollTouch(int64_t now, DeviceState state, bool allowed) {
+        int num = 0, x = 0, y = 0;
+        if (!touch_->Read(num, x, y)) return;
+        if (num > 0 && !touching_) {
+            touching_ = true;
+            touch_start_us_ = now;
+            touch_x0_ = touch_x_min_ = touch_x_max_ = x;
+            long_press_shown_ = false;
+        } else if (num > 0 && touching_) {
+            if (x < touch_x_min_) touch_x_min_ = x;
+            if (x > touch_x_max_) touch_x_max_ = x;
+            // 좌우로 문지르면 간지럼
+            if (allowed && !long_press_shown_ && touch_x_max_ - touch_x_min_ > 120) {
+                long_press_shown_ = true;
+                Show("laughing", 2500, state);
+            }
+            // 가만히 오래 대고 있으면 쓰다듬기
+            if (allowed && !long_press_shown_ && now - touch_start_us_ > 800 * 1000) {
+                long_press_shown_ = true;
+                SetFace("relaxed");
+                revert_at_us_ = 0;
+                if (on_activity_) on_activity_();
+            }
+        } else if (num == 0 && touching_) {
+            touching_ = false;
+            int64_t held = now - touch_start_us_;
+            if (!allowed) return;
+            if (long_press_shown_) {
+                // 쓰다듬기가 끝나면 좋아하는 얼굴
+                if (held > 800 * 1000 && touch_x_max_ - touch_x_min_ <= 120) Show("loving", 2500, state);
+                else if (revert_at_us_ == 0) Show("happy", 1500, state);
+                return;
+            }
+            // 짧게 톡: 최근 1.5초 안에 여러 번이면 콕콕 찌르기
+            for (int i = 3; i > 0; i--) tap_times_[i] = tap_times_[i - 1];
+            tap_times_[0] = now;
+            int recent = 0;
+            for (auto t : tap_times_) if (t && now - t < 1500 * 1000) recent++;
+            if (recent >= 4) {
+                Show("angry", 1500, state);
+                chained_ = "embarrassed";
+                chained_at_us_ = now + 1500 * 1000;
+                revert_at_us_ = now + 3200 * 1000;
+                tap_times_[1] = tap_times_[2] = tap_times_[3] = 0;
+            } else if (recent >= 2) {
+                Show(Rand(2) ? "surprised" : "embarrassed", 1500, state);
+            } else {
+                static const char* kTap[] = {"happy", "winking", "loving", "funny"};
+                Show(kTap[Rand(4)], 1500, state);
+            }
+        }
+    }
+
+    void PollShake(int64_t now, DeviceState state, bool allowed) {
+        float ax, ay, az;
+        accel_->Read(ax, ay, az);
+        float mag = std::sqrt(ax * ax + ay * ay + az * az);
+        float dev = std::fabs(mag - 1.0f);  // 가만히 있으면 1g
+        if (now - shake_window_us_ > 800 * 1000) {
+            shake_window_us_ = now;
+            shake_hits_ = 0;
+        }
+        if (dev > 0.7f) shake_hits_++;
+        if (shake_hits_ >= 3 && allowed && now - last_shake_us_ > 3 * 1000 * 1000) {
+            last_shake_us_ = now;
+            shake_hits_ = 0;
+            ESP_LOGI(RTAG, "Shake detected (%.2fg)", mag);
+            // 깜짝 → 어지러움(헷갈리는 얼굴) → 원래대로
+            Show("shocked", 1200, state);
+            chained_ = "confused";
+            chained_at_us_ = now + 1200 * 1000;
+            revert_at_us_ = now + 3500 * 1000;
+        }
+    }
+};
+
+}  // namespace stackchan_reactions
