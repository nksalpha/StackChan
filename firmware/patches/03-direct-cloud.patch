+
+bool DirectProtocol::SendAudio(std::unique_ptr<AudioStreamPacket> packet) {
+    if (!listening_ || !asr_ws_ || !asr_ws_->IsConnected()) return true;
+    // AudioService가 PCM16(16kHz, mono) 원음을 넘겨준다. 느린 네트워크면 8kHz로 줄여 보낸다
+    std::vector<uint8_t> data;
+    if (asr_rate_ == 8000) {
+        const int16_t* in = reinterpret_cast<const int16_t*>(packet->payload.data());
+        size_t n = packet->payload.size() / 2 / 2;
+        data.resize(n * 2);
+        int16_t* out = reinterpret_cast<int16_t*>(data.data());
+        for (size_t k = 0; k < n; k++) out[k] = (int16_t)(((int)in[2 * k] + (int)in[2 * k + 1]) / 2);
+    } else {
+        data = std::move(packet->payload);
+    }
+    int64_t ms = (int64_t)data.size() / (asr_rate_ / 1000 * 2);
+    {
+        std::lock_guard<std::mutex> lock(up_mutex_);
+        up_queue_.push_back(std::move(data));
+        up_queued_ms_ += ms;
+        // 2초 넘게 밀리면 오래된 것부터 버린다 (늦은 음성은 인식에 쓸모가 없다)
+        while (up_queued_ms_ > 2000 && !up_queue_.empty()) {
+            up_queued_ms_ -= (int64_t)up_queue_.front().size() / (asr_rate_ / 1000 * 2);
+            up_queue_.pop_front();
+            up_dropped_++;
+        }
+    }
+    up_cv_.notify_one();
+    return true;
+}
+
+void DirectProtocol::UploadLoop() {
+    while (true) {
+        std::vector<uint8_t> data;
+        int64_t queued_ms;
+        {
+            std::unique_lock<std::mutex> lock(up_mutex_);
+            up_cv_.wait(lock, [this]() { return stop_ || !up_queue_.empty(); });
+            if (stop_) return;
+            data = std::move(up_queue_.front());
+            up_queue_.pop_front();
+            int64_t ms = (int64_t)data.size() / (asr_rate_ / 1000 * 2);
+            up_queued_ms_ -= ms;
+            queued_ms = up_queued_ms_;
+        }
+        if (!listening_ || !asr_ws_ || !asr_ws_->IsConnected()) continue;
+        int64_t t0 = esp_timer_get_time();
+        last_audio_sent_us_ = t0;
+        asr_ws_->Send(data.data(), data.size(), true);
+        int64_t dt = esp_timer_get_time() - t0;
+
+        // 3초마다 업로드 상태 점검: 실시간의 70%도 못 보내거나 버린 게 있으면 "느림"
+        up_audio_ms_ += (int64_t)data.size() / (asr_rate_ / 1000 * 2);
+        if (dt > up_max_send_us_) up_max_send_us_ = dt;
+        if (up_window_start_us_ == 0) up_window_start_us_ = t0;
+        int64_t wall = esp_timer_get_time() - up_window_start_us_;
+        if (wall > 3 * 1000 * 1000) {
+            int dropped;
+            {
+                std::lock_guard<std::mutex> lock(up_mutex_);
+                dropped = up_dropped_;
+                up_dropped_ = 0;
+            }
+            ESP_LOGI(TAG, "UP audio=%lld ms wall=%lld ms slowest_send=%lld ms queued=%lld ms dropped=%d rate=%d",
+                     up_audio_ms_, wall / 1000, up_max_send_us_ / 1000, queued_ms, dropped, (int)asr_rate_);
+            bool bad = up_audio_ms_ * 10 < wall / 1000 * 7 || dropped > 0;
+            bool good = up_audio_ms_ * 100 >= wall / 1000 * 95 && up_max_send_us_ < 150 * 1000;
+            if (bad) {
+                good_windows_ = 0;
+                if (!slow_network_) ESP_LOGW(TAG, "Upload too slow, next session uses 8 kHz");
+                slow_network_ = true;
+                int64_t now = esp_timer_get_time();
+                if (now - last_notice_us_ > 300LL * 1000 * 1000) notice_pending_ = true;
+            } else if (good && slow_network_ && ++good_windows_ >= 10) {
+                ESP_LOGI(TAG, "Upload healthy again, next session uses 16 kHz");
+                slow_network_ = false;
+                good_windows_ = 0;
+            }
+            up_audio_ms_ = 0;
+            up_max_send_us_ = 0;
+            up_window_start_us_ = esp_timer_get_time();
+        }
+    }
+}
