+// direct-cloud: 서버 없이 기기에서 Deepgram(ASR) / DeepSeek(LLM) / Google TTS를 직접 호출한다.
+// 기존 Protocol 인터페이스를 그대로 구현하므로 Application 쪽 흐름(상태, 표정, 재생)은 바뀌지 않는다.
+#ifndef DIRECT_PROTOCOL_H
+#define DIRECT_PROTOCOL_H
+
+#include "protocol.h"
+
+#include <web_socket.h>
+#include <http.h>
+#include <esp_timer.h>
+
+#include <atomic>
+#include <condition_variable>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+struct DirectConfig {
+    std::string deepgram_key;
+    std::string deepseek_key;
+    std::string google_tts_key;
+    std::string llm_model;
+    std::string tts_voice;
+    bool IsComplete() const {
+        return !deepgram_key.empty() && !deepseek_key.empty() && !google_tts_key.empty();
+    }
+    static DirectConfig Load();
+};
+
+class DirectProtocol : public Protocol {
+public:
+    DirectProtocol();
+    ~DirectProtocol() override;
+
+    bool Start() override;
+    bool OpenAudioChannel() override;
+    void CloseAudioChannel(bool send_goodbye = true) override;
+    bool IsAudioChannelOpened() const override;
+    bool SendAudio(std::unique_ptr<AudioStreamPacket> packet) override;
+    void SendWakeWordDetected(const std::string& wake_word) override;
+    void SendStartListening(ListeningMode mode) override;
+    void SendStopListening() override;
+    void SendAbortSpeaking(AbortReason reason) override;
+    void SendMcpMessage(const std::string& message) override;
+
+private:
+    struct Sentence {
+        uint32_t turn;
+        std::string text;
+        bool last;
+    };
+    struct Packet {
+        uint32_t turn;
+        int sample_rate;
+        int frame_duration;
+        std::vector<uint8_t> payload;
+        bool last;
+    };
+
+    DirectConfig config_;
+    std::unique_ptr<WebSocket> asr_ws_;
+    std::atomic<bool> listening_{false};
+    std::atomic<uint32_t> turn_{0};
+    std::atomic<int64_t> last_audio_sent_us_{0};
+    esp_timer_handle_t keepalive_timer_ = nullptr;
+    void* opus_decoder_ = nullptr;
+    std::vector<int16_t> pcm_buf_;
+    std::string utterance_;
+    std::mutex asr_mutex_;
+
+    // 대화 기록 (user/assistant 번갈아)
+    std::deque<std::pair<std::string, std::string>> history_;
+    std::mutex history_mutex_;
+
+    // 작업 큐
+    std::mutex mutex_;
+    std::condition_variable cv_;
+    std::deque<std::pair<uint32_t, std::string>> llm_jobs_;
+    std::deque<Sentence> tts_jobs_;
+    std::deque<Packet> packets_;
+    bool stop_ = false;
+    std::thread llm_thread_, tts_thread_, player_thread_;
+
+    std::unique_ptr<Http> llm_http_;
+    std::unique_ptr<Http> tts_http_;
+
+    bool SendText(const std::string& text) override;
+    bool IsTimeout() const override { return false; }
+
+    void OnAsrMessage(const char* data, size_t len);
+    void FinishUtterance();
+    void EmitJson(const char* type, const char* key1, const char* val1,
+                  const char* key2 = nullptr, const char* val2 = nullptr);
+    void LlmLoop();
+    void TtsLoop();
+    void PlayerLoop();
+    void RunLlm(uint32_t turn, const std::string& user_text);
+    bool Synthesize(uint32_t turn, const std::string& text, bool last);
+    bool IsCurrent(uint32_t turn) const { return turn == turn_.load(); }
+    std::string BuildLlmBody(const std::string& user_text);
+    bool EnsureOpusDecoder();
+};
+
+#endif  // DIRECT_PROTOCOL_H
