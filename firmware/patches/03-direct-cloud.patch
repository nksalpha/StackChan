+
+DirectProtocol::~DirectProtocol() {
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        stop_ = true;
+    }
+    cv_.notify_all();
+    if (llm_thread_.joinable()) llm_thread_.join();
+    if (tts_thread_.joinable()) tts_thread_.join();
+    if (player_thread_.joinable()) player_thread_.join();
+    if (keepalive_timer_) {
+        esp_timer_stop(keepalive_timer_);
+        esp_timer_delete(keepalive_timer_);
+    }
+    if (opus_decoder_) esp_opus_dec_close(opus_decoder_);
+}
+
+bool DirectProtocol::Start() {
+    config_ = DirectConfig::Load();
+    if (!config_.IsComplete()) {
+        ESP_LOGE(TAG, "API keys missing (deepgram=%d deepseek=%d gtts=%d)",
+                 !config_.deepgram_key.empty(), !config_.deepseek_key.empty(),
+                 !config_.google_tts_key.empty());
+        SetError("API 키가 설정되지 않았어요. Wi-Fi 설정 화면의 고급 탭에서 입력해 주세요.");
+        return false;
+    }
+    ESP_LOGI(TAG, "Direct mode: llm=%s voice=%s", config_.llm_model.c_str(),
+             config_.tts_voice.c_str());
+
+    auto cfg = esp_pthread_get_default_config();
+    cfg.stack_size = 10 * 1024;
+    cfg.prio = 4;
+    cfg.thread_name = "direct_llm";
+    esp_pthread_set_cfg(&cfg);
+    llm_thread_ = std::thread([this]() { LlmLoop(); });
+    cfg.thread_name = "direct_tts";
+    esp_pthread_set_cfg(&cfg);
+    tts_thread_ = std::thread([this]() { TtsLoop(); });
+    cfg.stack_size = 4 * 1024;
+    cfg.prio = 6;
+    cfg.thread_name = "direct_play";
+    esp_pthread_set_cfg(&cfg);
+    player_thread_ = std::thread([this]() { PlayerLoop(); });
+    auto def = esp_pthread_get_default_config();
+    esp_pthread_set_cfg(&def);
+
+    // Deepgram은 10초 동안 아무것도 안 오면 연결을 닫으므로 KeepAlive를 보낸다
+    esp_timer_create_args_t targs = {
+        .callback =
+            [](void* arg) {
+                auto self = static_cast<DirectProtocol*>(arg);
+                if (self->asr_ws_ && self->asr_ws_->IsConnected() &&
+                    esp_timer_get_time() - self->last_audio_sent_us_ > 3 * 1000 * 1000) {
+                    self->asr_ws_->Send(std::string("{\"type\":\"KeepAlive\"}"));
+                }
+            },
+        .arg = this,
+        .dispatch_method = ESP_TIMER_TASK,
+        .name = "dg_keepalive",
+        .skip_unhandled_events = true,
+    };
+    esp_timer_create(&targs, &keepalive_timer_);
+    esp_timer_start_periodic(keepalive_timer_, 4 * 1000 * 1000);
+
+    if (on_connected_) on_connected_();
+    return true;
+}
