+constexpr int kTtsSampleRate = 24000;           // Google TTS 출력
+constexpr int64_t kPlaybackLeadUs = 200 * 1000; // 재생 큐에 미리 넣어 둘 오디오 길이
+constexpr size_t kHistoryTurns = 6;             // 기억할 대화 턴 수
+
+const char* kDeepgramUrl =
+    "wss://api.deepgram.com/v1/listen?model=nova-3&language=ko&encoding=linear16"
+    "&sample_rate=16000&channels=1&interim_results=true&endpointing=300"
+    "&utterance_end_ms=1000&smart_format=true&punctuate=true";
+const char* kDeepseekUrl = "https://api.deepseek.com/chat/completions";
+const char* kTtsUrl = "https://texttospeech.googleapis.com/v1/text:synthesize";
+
+const char* kSystemPrompt =
+    "너는 책상 위에 사는 작은 로봇 스택짱이야.\n"
+    "항상 한국어로, 두세 문장 이내로 짧게 대답해.\n"
+    "말투는 친근하지만 반말과 존댓말을 섞지 말고 존댓말로 통일해.\n"
+    "이모지, 마크다운, 목록 기호는 쓰지 마. 소리로 읽히는 대답이기 때문이야.\n"
+    "모르는 건 모른다고 말해.\n"
+    "대답 맨 앞에는 반드시 지금 감정을 대괄호 태그 하나로 붙여. 예: [happy] 안녕하세요.\n"
+    "쓸 수 있는 감정: happy, laughing, funny, loving, embarrassed, confident, delicious, "
+    "sad, crying, sleepy, silly, angry, surprised, shocked, thinking, winking, relaxed, "
+    "confused, neutral";
+
+const char* kEmotions[] = {"happy",    "laughing", "funny",   "loving",    "embarrassed",
+                           "confident", "delicious", "sad",    "crying",    "sleepy",
+                           "silly",    "angry",    "surprised", "shocked",  "thinking",
+                           "winking",  "relaxed",  "confused", "neutral"};
