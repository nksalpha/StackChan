+
+    // 업로드: 전송이 막혀도 기기가 굳지 않도록 별도 스레드와 대기열로 보낸다
+    std::mutex up_mutex_;
+    std::condition_variable up_cv_;
+    std::deque<std::vector<uint8_t>> up_queue_;
+    int64_t up_queued_ms_ = 0;
