+// 작은 base64 디코더 (Google TTS audioContent용)
+std::vector<uint8_t> Base64Decode(const char* in, size_t len) {
+    static int8_t table[256];
+    static bool init = false;
+    if (!init) {
+        memset(table, -1, sizeof(table));
+        const char* chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+        for (int i = 0; i < 64; i++) table[(uint8_t)chars[i]] = i;
+        init = true;
+    }
+    std::vector<uint8_t> out;
+    out.reserve(len * 3 / 4);
+    uint32_t acc = 0;
+    int bits = 0;
+    for (size_t i = 0; i < len; i++) {
+        int8_t v = table[(uint8_t)in[i]];
+        if (v < 0) continue;  // '=' 및 공백 무시
+        acc = (acc << 6) | v;
+        bits += 6;
+        if (bits >= 8) {
+            bits -= 8;
+            out.push_back((acc >> bits) & 0xFF);
+        }
+    }
+    return out;
+}
+
+// 문장 끝으로 볼 위치를 찾는다. 첫 문장은 쉼표에서도 끊어서 첫 소리를 빨리 낸다.
+size_t FindSentenceEnd(const std::string& s, bool first) {
+    for (size_t i = 0; i < s.size(); i++) {
+        char c = s[i];
+        if (c == '.' || c == '!' || c == '?' || c == '\n' || c == '~') {
+            // 소수점(3.5) 같은 경우는 넘긴다
+            if (c == '.' && i + 1 < s.size() && isdigit((unsigned char)s[i + 1])) continue;
+            return i + 1;
+        }
+        if (first && c == ',' && i >= 24) return i + 1;
+    }
+    return std::string::npos;
+}
+
+std::string Trim(const std::string& s) {
+    size_t b = s.find_first_not_of(" \t\r\n");
+    if (b == std::string::npos) return "";
+    size_t e = s.find_last_not_of(" \t\r\n");
+    return s.substr(b, e - b + 1);
+}
+
+// 소리로 읽을 때 방해되는 기호 제거
+std::string CleanForSpeech(const std::string& s) {
+    std::string out;
+    out.reserve(s.size());
+    for (char c : s) {
+        if (c == '*' || c == '#' || c == '`' || c == '_' || c == '>') continue;
+        out.push_back(c);
+    }
+    return Trim(out);
+}
