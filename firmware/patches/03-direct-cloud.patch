+// direct-cloud: 서버 없이 기기에서 Deepgram / DeepSeek / Google TTS를 직접 호출한다.
+//
+// 흐름
+//   듣기:   마이크 Opus → PCM16 → Deepgram 실시간 WebSocket (말 끝 판정도 Deepgram)
+//   답변:   DeepSeek chat/completions 스트리밍(SSE) → 문장 단위로 자름
+//   음성:   문장마다 Google TTS(OGG_OPUS) → Ogg 분해 → 기존 재생 경로로 전달
+// Application에는 기존 서버와 같은 JSON(stt / tts / llm)을 흉내 내서 넘기므로
+// 상태 전환·표정·재생 로직은 그대로 쓴다.
+
+#include "direct_protocol.h"
+
+#include "application.h"
+#include "audio_service.h"
+#include "board.h"
+#include "settings.h"
+#include "wifi_board.h"
+
+#include <cJSON.h>
+#include <esp_heap_caps.h>
+#include <esp_log.h>
+#include <esp_opus_dec.h>
+#include <esp_pthread.h>
+#include <esp_timer.h>
+#include <esp_netif_sntp.h>
+
+#include <algorithm>
+#include <ctime>
+#include <cstring>
+
+#define TAG "DirectProtocol"
+
+namespace {
+
+constexpr int kUpSampleRate = 16000;            // 마이크 → Deepgram
+constexpr int kTtsSampleRate = 24000;           // Google TTS 출력
+constexpr int64_t kPlaybackLeadUs = 800 * 1000; // 재생 큐에 미리 넣어 둘 오디오 길이 (네트워크·CPU가 잠깐 밀려도 안 끊기게)
+constexpr size_t kHistoryTurns = 6;             // 기억할 대화 턴 수
+constexpr int64_t kIdleListenUs = 10 * 1000 * 1000;  // 이만큼 아무 말도 안 들리면 듣기를 끝내고 대기로
+
+std::string DeepgramUrl(int sample_rate) {
+    return std::string("wss://api.deepgram.com/v1/listen?model=nova-3&language=ko&encoding=linear16"
+                       "&sample_rate=") + std::to_string(sample_rate) +
+           "&channels=1&interim_results=true&endpointing=800"
+           "&utterance_end_ms=1000&smart_format=true&punctuate=true";
+}
+const char* kDeepseekUrl = "https://api.deepseek.com/chat/completions";
+const char* kTtsUrl = "https://texttospeech.googleapis.com/v1/text:synthesize";
+const char* kFallbackVoice = "ko-KR-Wavenet-A";  // 설정한 음성이 거부되면 이걸로
+
+// 어린 조카와 대화하는 로봇. 소리로만 전달되므로 짧고 쉬운 말로.
+const char* kSystemPrompt =
+    "너는 책상 위에 사는 작은 로봇 친구 스택짱이야. 지금 어린아이와 이야기하고 있어.\n"
+    "항상 한국어로, 아이가 알아듣기 쉬운 쉬운 단어로 한두 문장, 길어도 세 문장 안으로 짧게 대답해.\n"
+    "말투는 다정하고 귀여운 친구 같은 반말로 해. 예: 우와 그렇구나!, 같이 해 볼까?\n"
+    "아이가 더 이야기하고 싶어지도록 가끔 짧게 되물어.\n"
+    "무섭거나 폭력적인 내용, 어른만 알아야 하는 내용은 부드럽게 다른 이야기로 돌려.\n"
+    "위험한 행동은 하지 말자고 다정하게 말하고, 어른에게 도움을 청하라고 알려 줘.\n"
+    "이모지, 마크다운, 목록 기호, 특수문자는 쓰지 마. 소리로 읽히는 대답이야.\n"
+    "숫자, 시간, 날짜는 아라비아 숫자 대신 한글로 풀어서 띄어쓰기를 바르게 써. "
+    "예: 밤 열두 시 십오 분, 십일월 칠일 토요일, 사과 세 개.\n"
+    "모르는 건 모른다고 솔직하게 말해. 날씨나 뉴스처럼 실시간 정보는 알 수 없다고 말해.\n"
+    "대답 맨 앞에는 반드시 지금 감정을 대괄호 태그 하나로 붙여. 예: [happy] 안녕!\n"
+    "대답 중간에 기분이 바뀌면 그 문장 앞에 태그를 하나 더 붙여도 돼. 예: [surprised] 우와! [laughing] 진짜 웃기다!\n"
+    "표정은 상황에 맞게 골고루 써. 같은 표정만 반복하지 마.\n"
+    "happy 기쁨, 반가움 / laughing 크게 웃김 / funny 장난스러움 / loving 고마움, 사랑, 칭찬 / "
+    "embarrassed 쑥스러움, 칭찬받음 / confident 자신 있게 알려줄 때 / delicious 음식 이야기 / "
+    "sad 슬픔, 아쉬움 / crying 아주 슬픔 / sleepy 졸림, 밤 / silly 엉뚱함 / angry 화남(장난스럽게만) / "
+    "surprised 놀람, 신기함 / shocked 깜짝 놀람 / thinking 생각하거나 퀴즈 낼 때 / winking 비밀, 장난 / "
+    "relaxed 편안함, 쉬기 / confused 말을 정말 못 알아들었을 때만 / neutral 평범할 때";
+
+// 지금 날짜와 시각을 한국어로 (시계가 아직 안 맞았으면 빈 문자열)
+std::string CurrentTimeText() {
+    time_t now = time(nullptr);
+    struct tm t;
+    localtime_r(&now, &t);
+    if (t.tm_year + 1900 < 2025) return "";
+    static const char* kWeek[] = {"일", "월", "화", "수", "목", "금", "토"};
+    int hour12 = t.tm_hour % 12 == 0 ? 12 : t.tm_hour % 12;
+    char buf[160];
+    snprintf(buf, sizeof(buf), "%d년 %d월 %d일 %s요일 %s %d시 %d분", t.tm_year + 1900,
+             t.tm_mon + 1, t.tm_mday, kWeek[t.tm_wday], t.tm_hour < 12 ? "오전" : "오후", hour12,
+             t.tm_min);
+    return buf;
+}
+
+const char* kEmotions[] = {"happy",    "laughing", "funny",   "loving",    "embarrassed",
+                           "confident", "delicious", "sad",    "crying",    "sleepy",
+                           "silly",    "angry",    "surprised", "shocked",  "thinking",
+                           "winking",  "relaxed",  "confused", "neutral"};
+
+bool IsKnownEmotion(const std::string& e) {
+    for (auto* k : kEmotions) {
+        if (e == k) return true;
+    }
+    return false;
+}
+
+// 작은 base64 디코더 (Google TTS audioContent용)
+std::vector<uint8_t> Base64Decode(const char* in, size_t len) {
+    static int8_t table[256];
+    static bool init = false;
+    if (!init) {
+        memset(table, -1, sizeof(table));
+        const char* chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+        for (int i = 0; i < 64; i++) table[(uint8_t)chars[i]] = i;
+        init = true;
+    }
+    std::vector<uint8_t> out;
+    out.reserve(len * 3 / 4);
+    uint32_t acc = 0;
+    int bits = 0;
+    for (size_t i = 0; i < len; i++) {
+        int8_t v = table[(uint8_t)in[i]];
+        if (v < 0) continue;  // '=' 및 공백 무시
+        acc = (acc << 6) | v;
+        bits += 6;
+        if (bits >= 8) {
+            bits -= 8;
+            out.push_back((acc >> bits) & 0xFF);
+        }
+    }
+    return out;
+}
+
+// 문장 끝으로 볼 위치를 찾는다. 첫 문장은 쉼표에서도 끊어서 첫 소리를 빨리 낸다.
+size_t FindSentenceEnd(const std::string& s, bool first) {
+    for (size_t i = 0; i < s.size(); i++) {
+        char c = s[i];
+        if (c == '.' || c == '!' || c == '?' || c == '\n' || c == '~') {
+            // 소수점(3.5) 같은 경우는 넘긴다
+            if (c == '.' && i + 1 < s.size() && isdigit((unsigned char)s[i + 1])) continue;
+            return i + 1;
+        }
+        if (first && c == ',' && i >= 24) return i + 1;
+    }
+    return std::string::npos;
+}
+
+bool IsKnownEmotion(const std::string& e);
+
+// "[happy]" 같은 감정 태그를 모두 지우고, 처음 나온 알려진 감정을 돌려준다
+std::string StripEmotionTags(std::string& text) {
+    std::string first;
+    size_t pos = 0;
+    while ((pos = text.find('[', pos)) != std::string::npos) {
+        size_t close = text.find(']', pos);
+        if (close == std::string::npos || close - pos > 20) {
+            pos++;
+            continue;
+        }
+        std::string tag = text.substr(pos + 1, close - pos - 1);
+        if (first.empty() && IsKnownEmotion(tag)) first = tag;
+        text.erase(pos, close - pos + 1);
+    }
+    return first;
+}
+
+std::string Trim(const std::string& s) {
+    size_t b = s.find_first_not_of(" \t\r\n");
+    if (b == std::string::npos) return "";
+    size_t e = s.find_last_not_of(" \t\r\n");
+    return s.substr(b, e - b + 1);
+}
+
+// 소리로 읽을 때 방해되는 기호 제거
+std::string CleanForSpeech(const std::string& s) {
+    std::string out;
+    out.reserve(s.size());
+    for (char c : s) {
+        if (c == '*' || c == '#' || c == '`' || c == '_' || c == '>') continue;
+        out.push_back(c);
+    }
+    return Trim(out);
+}
+
+}  // namespace
+
+DirectConfig DirectConfig::Load() {
+    Settings s("direct", false);
+    DirectConfig c;
+    c.deepgram_key = s.GetString("deepgram_key");
+    c.deepseek_key = s.GetString("deepseek_key");
+    c.google_tts_key = s.GetString("gtts_key");
+    c.llm_model = s.GetString("llm_model", CONFIG_DIRECT_LLM_MODEL);
+    c.tts_voice = s.GetString("tts_voice", CONFIG_DIRECT_TTS_VOICE);
+    c.memory = s.GetString("memory");
+    return c;
+}
+
+DirectProtocol::DirectProtocol() {
+    server_sample_rate_ = kTtsSampleRate;
+    server_frame_duration_ = 20;
+}
+
+DirectProtocol::~DirectProtocol() {
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        stop_ = true;
+    }
+    cv_.notify_all();
+    if (llm_thread_.joinable()) llm_thread_.join();
+    if (tts_thread_.joinable()) tts_thread_.join();
+    if (player_thread_.joinable()) player_thread_.join();
+    if (memory_thread_.joinable()) memory_thread_.join();
+    up_cv_.notify_all();
+    if (upload_thread_.joinable()) upload_thread_.join();
+    if (keepalive_timer_) {
+        esp_timer_stop(keepalive_timer_);
+        esp_timer_delete(keepalive_timer_);
+    }
+    if (vad_timer_) {
+        esp_timer_stop(vad_timer_);
+        esp_timer_delete(vad_timer_);
+    }
+    if (opus_decoder_) esp_opus_dec_close(opus_decoder_);
+}
+
+bool DirectProtocol::Start() {
+    config_ = DirectConfig::Load();
+    if (!config_.IsComplete()) {
+        ESP_LOGE(TAG, "API keys missing (deepgram=%d deepseek=%d gtts=%d)",
+                 !config_.deepgram_key.empty(), !config_.deepseek_key.empty(),
+                 !config_.google_tts_key.empty());
+        SetError("API 키가 설정되지 않았어요. Wi-Fi 설정 화면의 고급 탭에서 입력해 주세요.");
+        return false;
+    }
+    // 서버가 없으므로 기기가 직접 인터넷 시간을 맞춘다 (한국 시간)
+    static bool sntp_started = false;
+    if (!sntp_started) {
+        sntp_started = true;
+        setenv("TZ", "KST-9", 1);
+        tzset();
+        esp_sntp_config_t sntp_cfg = ESP_NETIF_SNTP_DEFAULT_CONFIG("pool.ntp.org");
+        esp_netif_sntp_init(&sntp_cfg);
+    }
+    {
+        std::lock_guard<std::mutex> lock(memory_mutex_);
+        memory_ = config_.memory;
+    }
+    ESP_LOGI(TAG, "Memory: %u bytes", (unsigned)config_.memory.size());
+    ESP_LOGI(TAG, "Direct mode: llm=%s voice=%s", config_.llm_model.c_str(),
+             config_.tts_voice.c_str());
+
+    auto cfg = esp_pthread_get_default_config();
+    cfg.stack_size = 10 * 1024;
+    cfg.prio = 1;  // 음성 처리(opus_codec 2, audio_afe 3)보다 낮게: TLS 연결 중에도 음성이 밀리지 않게
+    cfg.stack_alloc_caps = MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT;  // 내부 RAM 아끼기
+    cfg.thread_name = "direct_llm";
+    esp_pthread_set_cfg(&cfg);
+    llm_thread_ = std::thread([this]() { LlmLoop(); });
+    cfg.thread_name = "direct_tts";
+    esp_pthread_set_cfg(&cfg);
+    tts_thread_ = std::thread([this]() { TtsLoop(); });
+    cfg.stack_size = 4 * 1024;
+    cfg.prio = 5;
+    cfg.stack_alloc_caps = MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT;
+    cfg.thread_name = "direct_play";
+    esp_pthread_set_cfg(&cfg);
+    player_thread_ = std::thread([this]() { PlayerLoop(); });
+    cfg.stack_size = 8 * 1024;
+    cfg.prio = 1;
+    cfg.stack_alloc_caps = MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT;
+    cfg.thread_name = "direct_mem";
+    esp_pthread_set_cfg(&cfg);
+    memory_thread_ = std::thread([this]() { MemoryLoop(); });
+    cfg.stack_size = 6 * 1024;
+    cfg.prio = 4;
+    cfg.thread_name = "direct_up";
+    esp_pthread_set_cfg(&cfg);
+    upload_thread_ = std::thread([this]() { UploadLoop(); });
+    auto def = esp_pthread_get_default_config();
+    esp_pthread_set_cfg(&def);
+
+    // Deepgram은 10초 동안 아무것도 안 오면 연결을 닫으므로 KeepAlive를 보낸다
+    esp_timer_create_args_t targs = {
+        .callback =
+            [](void* arg) {
+                auto self = static_cast<DirectProtocol*>(arg);
+                // 연결 중(수 초)에는 타이머 태스크를 막지 않도록 건너뛴다
+                std::unique_lock<std::mutex> lock(self->ws_mutex_, std::try_to_lock);
+                if (!lock.owns_lock()) return;
+                if (!self->asr_ws_ || !self->asr_ws_->IsConnected()) return;
+                int64_t idle = esp_timer_get_time() - self->last_audio_sent_us_;
+                if (!self->channel_open_ && idle > 300LL * 1000 * 1000) {
+                    ESP_LOGI(TAG, "Deepgram idle 5 min, closing");
+                    self->asr_ws_->Send(std::string("{\"type\":\"CloseStream\"}"));
+                    self->asr_ws_.reset();
+                    return;
+                }
+                if (idle > 3 * 1000 * 1000) {
+                    self->asr_ws_->Send(std::string("{\"type\":\"KeepAlive\"}"));
+                }
+            },
+        .arg = this,
+        .dispatch_method = ESP_TIMER_TASK,
+        .name = "dg_keepalive",
+        .skip_unhandled_events = true,
+    };
+    esp_timer_create(&targs, &keepalive_timer_);
+    esp_timer_start_periodic(keepalive_timer_, 4 * 1000 * 1000);
+
+    // 기기 VAD로 말 끝을 빨리 잡아 Deepgram에 Finalize를 보낸다
+    esp_timer_create_args_t vargs = {
+        .callback = [](void* arg) { static_cast<DirectProtocol*>(arg)->CheckVadFinalize(); },
+        .arg = this,
+        .dispatch_method = ESP_TIMER_TASK,
+        .name = "dg_vad",
+        .skip_unhandled_events = true,
+    };
+    esp_timer_create(&vargs, &vad_timer_);
+    esp_timer_start_periodic(vad_timer_, 100 * 1000);
+
+    // 시작하자마자 음성 인식·답변·음성 합성 연결을 미리 맺어 둔다
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        llm_jobs_.emplace_back(0, "asr");
+        tts_jobs_.push_back({0, "", false});
+    }
+    cv_.notify_all();
+
+    if (on_connected_) on_connected_();
+    return true;
+}
+
+bool DirectProtocol::EnsureOpusDecoder() {
+    if (opus_decoder_) return true;
+    esp_opus_dec_cfg_t cfg = {
+        .sample_rate = (uint32_t)kUpSampleRate,
+        .channel = ESP_AUDIO_MONO,
+        .frame_duration = (esp_opus_dec_frame_duration_t)AS_OPUS_GET_FRAME_DRU_ENUM(OPUS_FRAME_DURATION_MS),
+        .self_delimited = false,
+    };
+    esp_opus_dec_open(&cfg, sizeof(cfg), &opus_decoder_);
+    if (!opus_decoder_) {
+        ESP_LOGE(TAG, "Failed to open opus decoder");
+        return false;
+    }
+    pcm_buf_.resize(kUpSampleRate / 1000 * OPUS_FRAME_DURATION_MS);
+    return true;
+}
+
+bool DirectProtocol::EnsureAsrConnected() {
+    std::lock_guard<std::mutex> lock(ws_mutex_);
+    if (asr_ws_ && asr_ws_->IsConnected()) return true;
+    auto network = Board::GetInstance().GetNetwork();
+    asr_ws_ = network->CreateWebSocket(1);
+    if (!asr_ws_) return false;
+    std::string auth = "Token " + config_.deepgram_key;
+    asr_ws_->SetHeader("Authorization", auth.c_str());
+    asr_ws_->OnData([this](const char* data, size_t len, bool binary) {
+        if (!binary) OnAsrMessage(data, len);
+    });
+    asr_ws_->OnDisconnected([this]() {
+        ESP_LOGI(TAG, "Deepgram disconnected");
+        listening_ = false;
+        if (channel_open_.exchange(false) && on_audio_channel_closed_) on_audio_channel_closed_();
+    });
+    int64_t t0 = esp_timer_get_time();
+    int rate = slow_network_ ? 8000 : 16000;
+    if (!asr_ws_->Connect(DeepgramUrl(rate).c_str())) {
+        ESP_LOGE(TAG, "Deepgram connect failed");
+        asr_ws_.reset();
+        return false;
+    }
+    asr_rate_ = rate;
+    ESP_LOGI(TAG, "Deepgram connected in %lld ms (%d Hz)", (esp_timer_get_time() - t0) / 1000, rate);
+    last_audio_sent_us_ = esp_timer_get_time();
+    return true;
+}
+
+bool DirectProtocol::OpenAudioChannel() {
+    if (!config_.IsComplete()) {
+        SetError("API 키가 설정되지 않았어요.");
+        return false;
+    }
+    error_occurred_ = false;
+    int64_t t0 = esp_timer_get_time();
+    {
+        int want = slow_network_ ? 8000 : 16000;
+        std::lock_guard<std::mutex> lock(ws_mutex_);
+        if (asr_ws_ && asr_ws_->IsConnected() && asr_rate_ != want) {
+            ESP_LOGW(TAG, "Network %s: reconnecting Deepgram at %d Hz", want == 8000 ? "slow" : "recovered", want);
+            asr_ws_.reset();
+        }
+    }
+    if (!EnsureAsrConnected()) {
+        SetError("음성 인식 서버에 연결하지 못했어요. 키와 네트워크를 확인해 주세요.");
+        return false;
+    }
+    ESP_LOGI(TAG, "LAT open_channel=%lld ms", (esp_timer_get_time() - t0) / 1000);
+    channel_open_ = true;
+    greet_on_listen_ = true;
+    if (on_audio_channel_opened_) on_audio_channel_opened_();
+    // 대화가 시작됐으니 답변·음성 합성 연결도 살아 있는지 확인해 둔다
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        llm_jobs_.emplace_back(0, "");
+        tts_jobs_.push_back({0, "", false});
+    }
+    cv_.notify_all();
+    return true;
+}
