+
+bool DirectProtocol::SendAudio(std::unique_ptr<AudioStreamPacket> packet) {
+    if (!listening_ || !asr_ws_ || !asr_ws_->IsConnected()) return true;
+    if (!EnsureOpusDecoder()) return false;
+
+    esp_audio_dec_in_raw_t raw = {
+        .buffer = packet->payload.data(),
+        .len = (uint32_t)packet->payload.size(),
+        .consumed = 0,
+        .frame_recover = ESP_AUDIO_DEC_RECOVERY_NONE,
+    };
+    esp_audio_dec_out_frame_t out = {
+        .buffer = (uint8_t*)pcm_buf_.data(),
+        .len = (uint32_t)(pcm_buf_.size() * sizeof(int16_t)),
+        .decoded_size = 0,
+    };
+    esp_audio_dec_info_t info = {};
+    if (esp_opus_dec_decode(opus_decoder_, &raw, &out, &info) != ESP_AUDIO_ERR_OK) {
+        return true;
+    }
+    last_audio_sent_us_ = esp_timer_get_time();
+    return asr_ws_->Send(pcm_buf_.data(), out.decoded_size, true);
+}
