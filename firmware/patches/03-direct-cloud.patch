+    int64_t up_window_start_us_ = 0;
+
+    // 대화 기록 (user/assistant 번갈아)
+    std::deque<std::pair<std::string, std::string>> history_;
+    std::mutex history_mutex_;
+
+    // 작업 큐
+    std::mutex mutex_;
+    std::condition_variable cv_;
+    std::deque<std::pair<uint32_t, std::string>> llm_jobs_;  // turn 0 = 연결 예열
+    std::deque<Sentence> tts_jobs_;
+    std::deque<Chunk> chunks_;
+    bool stop_ = false;
